{
  "name": "jhin-ai",
  "version": "0.0.0",
  "private": true,
  "description": "Jhin: a self-hosted AI harness where everything is a plugin",
  "bin": {
    "jhin": "./bin/jhin.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "bin": {
      "jhin": "./dist/main.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@jhin/mcp-bridge": "workspace:*",
    "@jhin/node-host": "workspace:*",
    "@jhin/plugin-agent-fake": "workspace:*",
    "@jhin/plugin-auth-token": "workspace:*",
    "@jhin/plugin-example": "workspace:*",
    "@jhin/plugin-http": "workspace:*",
    "@jhin/plugin-mcp-server": "workspace:*",
    "@jhin/plugin-mesh": "workspace:*",
    "@jhin/plugin-storage-sqlite": "workspace:*",
    "@jhin/plugin-threads": "workspace:*",
    "@jhin/plugin-transport-ws": "workspace:*",
    "@jhin/plugin-web-ui": "workspace:*",
    "@jhin/rpc": "workspace:*",
    "@jhin/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:"
  },
  "devDependencies": {
    "@jhin/storage-api": "workspace:*",
    "@types/node": "catalog:"
  },
  "jhinClient": [
    "@jhin/plugin-http",
    "@jhin/plugin-web-ui"
  ],
  "jhinDistribution": [
    "@jhin/plugin-example",
    "@jhin/plugin-storage-sqlite",
    "@jhin/plugin-http",
    "@jhin/plugin-auth-token",
    "@jhin/plugin-transport-ws",
    "@jhin/plugin-threads",
    "@jhin/plugin-agent-fake",
    "@jhin/plugin-mcp-server",
    "@jhin/plugin-mesh"
  ],
  "jhinUi": [
    "@jhin/plugin-web-ui"
  ]
}
