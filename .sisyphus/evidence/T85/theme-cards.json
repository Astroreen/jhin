{
  "cards": [
    {
      "type": "box",
      "id": "theme-t3-chat",
      "padding": "$spacing.md",
      "borderRadius": "$radius.md",
      "borderWidth": 1,
      "border": "$color.primary",
      "onTap": {
        "op": "setState",
        "id": "themeId",
        "value": "t3-chat"
      },
      "child": {
        "type": "container",
        "direction": "column",
        "gap": 8,
        "children": [
          {
            "type": "row",
            "gap": 8,
            "children": [
              {
                "type": "sized_box",
                "id": "swatch-t3-chat-canvas",
                "width": 40,
                "height": 24,
                "color": "#fdf7fd"
              },
              {
                "type": "sized_box",
                "id": "swatch-t3-chat-accent",
                "width": 40,
                "height": 24,
                "color": "#db2777"
              }
            ]
          },
          {
            "type": "text",
            "text": "T3 Chat",
            "style": "body"
          },
          {
            "type": "row",
            "gap": 8,
            "children": [
              {
                "type": "chip",
                "label": "Light",
                "avatar": {
                  "type": "sized_box",
                  "id": "chip-t3-chat-light",
                  "width": 40,
                  "height": 24,
                  "color": "#db2777"
                }
              },
              {
                "type": "chip",
                "label": "Dark",
                "avatar": {
                  "type": "sized_box",
                  "id": "chip-t3-chat-dark",
                  "width": 40,
                  "height": 24,
                  "color": "#a3004c"
                }
              }
            ]
          }
        ]
      }
    },
