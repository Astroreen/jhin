                                "child": {
                                  "type": "container",
                                  "direction": "column",
                                  "gap": 8,
                                  "children": [
                                    {
                                      "type": "row",
                                      "gap": 8,
                                      "children": [
                                        {
                                          "type": "sized_box",
                                          "id": "swatch-iris-canvas",
                                          "width": 40,
