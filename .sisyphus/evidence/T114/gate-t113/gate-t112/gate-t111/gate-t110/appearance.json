                              "type": "expanded",
                              "child": {
                                "type": "box",
                                "id": "theme-jhin",
                                "padding": "$spacing.md",
                                "borderRadius": "$radius.md",
                                "borderWidth": 1,
                                "border": "$color.border",
                                "onTap": {
                                  "op": "setState",
                                  "id": "themeId",
                                  "value": "jhin"
                                },
                                "child": {
                                  "type": "container",
                                  "direction": "column",
                                  "gap": 8,
                                  "children": [
                                    {
                                      "type": "row",
                                      "gap": 8,
                                      "children": [
                                        {
                                          "type": "sized_box",
                                          "id": "swatch-jhin-canvas",
                                          "width": 40,
                                          "height": 24,
                                          "color": "#16161e"
                                        },
                                        {
                                          "type": "sized_box",
                                          "id": "swatch-jhin-accent",
                                          "width": 40,
                                          "height": 24,
                                          "color": "#7E57C2"
                                        }
                                      ]
                                    },
                                    {
                                      "type": "text",
                                      "text": "Jhin",
                                      "style": "body"
                                    },
                                    {
                                      "type": "row",
                                      "gap": 8,
                                      "children": [
