{
  "type": "screen",
  "title": "Settings",
  "body": {
    "type": "shell",
    "id": "settings-shell",
    "breakpoint": 768,
    "topbar": {
      "type": "row",
      "id": "settings-topbar",
      "align": "center",
      "children": [
        {
          "type": "text",
          "text": "Jhin",
          "style": "h3",
          "bold": true
        },
        {
          "type": "spacer"
        },
        {
          "type": "button",
          "label": "Back to threads",
          "style": "secondary",
          "action": {
            "op": "navigate",
            "screen": "sessions"
          }
        }
      ]
    },
    "topbarCompact": {
      "type": "row",
      "id": "settings-topbar-compact",
      "align": "center",
      "children": [
        {
          "type": "text",
          "text": "Jhin",
          "style": "h3",
          "bold": true
        },
        {
          "type": "spacer"
        }
      ]
    },
    "pageHeader": {
      "type": "row",
      "id": "settings-breadcrumb",
      "align": "center",
      "gap": 8,
      "children": [
        {
          "type": "text",
          "text": "Settings",
          "style": "small"
        },
        {
          "type": "text",
          "text": "/",
          "style": "small"
        },
        {
          "type": "text",
          "text": "Appearance",
          "style": "body",
          "bold": true
        }
      ]
    },
    "sidebar": {
      "type": "nav",
      "id": "settings-nav",
      "kind": "sidebar",
      "items": [
        {
          "id": "settings:general",
          "label": "General",
          "icon": "settings",
          "screen": "settings:general"
        },
        {
          "id": "settings:appearance",
          "label": "Appearance",
          "icon": "palette",
          "screen": "settings:appearance"
        },
        {
          "id": "settings:keybindings",
          "label": "Keybindings",
          "icon": "keyboard",
          "screen": "settings:keybindings"
        },
        {
          "id": "settings:providers",
          "label": "Providers",
          "icon": "smart_toy",
          "screen": "settings:providers"
        },
        {
          "id": "settings:connections",
          "label": "Connections",
          "icon": "link",
          "screen": "settings:connections"
        },
        {
          "id": "settings:integrations",
          "label": "Integrations",
          "icon": "extension",
          "screen": "settings:integrations"
        },
        {
          "id": "settings:diagnostics",
          "label": "Diagnostics",
          "icon": "monitor_heart",
          "screen": "settings:diagnostics"
        },
        {
          "id": "settings:storage",
          "label": "Storage",
          "icon": "storage",
          "screen": "settings:storage"
        },
        {
          "id": "settings:archived",
          "label": "Archive",
          "icon": "archive",
          "screen": "settings:archived"
        },
        {
          "id": "settings:projects",
          "label": "Project",
          "icon": "folder",
          "screen": "settings:projects"
        },
        {
          "id": "settings:scheduled-tasks",
          "label": "Scheduled Tasks",
          "icon": "schedule",
          "screen": "settings:scheduled-tasks"
        },
        {
          "id": "settings:source-control",
          "label": "Source Control",
          "icon": "account_tree",
          "screen": "settings:source-control"
        },
        {
          "id": "settings:snap-shot",
          "label": "SnapShots",
          "icon": "photo_camera",
          "screen": "settings:snap-shot"
        },
        {
          "id": "settings:licenses",
          "label": "Open source licenses",
          "icon": "description",
          "screen": "settings:licenses"
        }
      ],
      "activeId": "settings:appearance"
    },
    "stageBackdrop": true,
    "body": {
      "type": "container",
      "direction": "column",
      "gap": 12,
      "padding": 16,
      "children": [
        {
          "type": "card",
          "id": "section-appearance",
          "title": "Appearance",
          "children": [
            {
              "type": "switch",
              "id": "fold_appearance",
              "label": "Appearance",
              "value": false,
              "visible": false
            },
            {
              "type": "row",
              "id": "section-appearance-toggle",
              "align": "center",
              "gap": 8,
              "when": "fold_appearance != true",
              "onTap": {
                "op": "setState",
                "id": "fold_appearance",
                "value": true
              },
              "children": [
                {
                  "type": "icon",
                  "icon": "chevron_right",
                  "size": 16,
                  "color": "$color.muted-foreground"
                },
                {
                  "type": "text",
                  "text": "Theme, mode and seed colors",
                  "style": "caption"
                }
              ]
            },
            {
              "type": "row",
              "id": "section-appearance-toggle-open",
              "align": "center",
              "gap": 8,
              "when": "fold_appearance == true",
              "onTap": {
                "op": "setState",
                "id": "fold_appearance",
                "value": false
              },
              "children": [
                {
                  "type": "icon",
                  "icon": "expand_more",
                  "size": 16,
                  "color": "$color.muted-foreground"
                },
                {
                  "type": "text",
                  "text": "Theme, mode and seed colors",
                  "style": "caption"
                }
              ]
            },
            {
              "type": "container",
              "id": "section-appearance-body",
              "direction": "column",
              "gap": 8,
              "when": "fold_appearance == true",
              "children": [
                {
                  "type": "container",
                  "direction": "column",
                  "gap": 8,
                  "children": [
                    {
                      "type": "container",
                      "direction": "column",
                      "gap": 8,
                      "children": [
                        {
                          "type": "row",
                          "gap": 8,
                          "children": [
                            {
                              "type": "expanded",
                              "child": {
                                "type": "box",
                                "id": "theme-t3-chat",
                                "padding": "$spacing.md",
                                "borderRadius": "$radius.md",
                                "borderWidth": 1,
                                "border": "$color.border",
                                "onTap": {
                                  "op": "setState",
                                  "id": "themeId",
                                  "value": "t3-chat"
                                },
                                "child": {
                                  "type": "container",
                                  "direction": "column",
                                  "gap": 8,
                                  "children": [
                                    {
                                      "type": "row",
                                      "gap": 8,
                                      "children": [
                                        {
                                          "type": "sized_box",
                                          "id": "swatch-t3-chat-canvas",
                                          "width": 40,
                                          "height": 24,
                                          "color": "#1f1a24"
                                        },
                                        {
                                          "type": "sized_box",
                                          "id": "swatch-t3-chat-accent",
                                          "width": 40,
                                          "height": 24,
                                          "color": "#a3004c"
                                        }
                                      ]
                                    },
                                    {
                                      "type": "text",
                                      "text": "T3 Chat",
                                      "style": "body"
                                    },
                                    {
                                      "type": "row",
                                      "gap": 8,
                                      "children": [
                                        {
                                          "type": "chip",
                                          "label": "Light",
                                          "avatar": {
                                            "type": "sized_box",
                                            "id": "chip-t3-chat-light",
                                            "width": 40,
                                            "height": 24,
                                            "color": "#db2777"
                                          }
                                        },
                                        {
                                          "type": "chip",
                                          "label": "Dark",
                                          "avatar": {
                                            "type": "sized_box",
                                            "id": "chip-t3-chat-dark",
                                            "width": 40,
                                            "height": 24,
                                            "color": "#a3004c"
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                }
                              }
                            },
                            {
                              "type": "expanded",
                              "child": {
                                "type": "box",
                                "id": "theme-grove",
                                "padding": "$spacing.md",
                                "borderRadius": "$radius.md",
                                "borderWidth": 1,
                                "border": "$color.border",
                                "onTap": {
                                  "op": "setState",
                                  "id": "themeId",
                                  "value": "grove"
                                },
                                "child": {
                                  "type": "container",
                                  "direction": "column",
                                  "gap": 8,
                                  "children": [
                                    {
                                      "type": "row",
                                      "gap": 8,
                                      "children": [
                                        {
                                          "type": "sized_box",
                                          "id": "swatch-grove-canvas",
                                          "width": 40,
                                          "height": 24,
                                          "color": "#1b2821"
                                        },
                                        {
                                          "type": "sized_box",
                                          "id": "swatch-grove-accent",
                                          "width": 40,
                                          "height": 24,
                                          "color": "#69d69a"
                                        }
                                      ]
                                    },
                                    {
                                      "type": "text",
                                      "text": "Grove",
                                      "style": "body"
                                    },
                                    {
                                      "type": "row",
                                      "gap": 8,
                                      "children": [
                                        {
                                          "type": "chip",
                                          "label": "Light",
                                          "avatar": {
                                            "type": "sized_box",
                                            "id": "chip-grove-light",
                                            "width": 40,
                                            "height": 24,
                                            "color": "#1b7d50"
                                          }
                                        },
                                        {
                                          "type": "chip",
                                          "label": "Dark",
                                          "avatar": {
                                            "type": "sized_box",
                                            "id": "chip-grove-dark",
                                            "width": 40,
                                            "height": 24,
                                            "color": "#69d69a"
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                }
                              }
                            },
                            {
                              "type": "expanded",
                              "child": {
                                "type": "box",
                                "id": "theme-ocean",
                                "padding": "$spacing.md",
                                "borderRadius": "$radius.md",
                                "borderWidth": 1,
                                "border": "$color.primary",
                                "onTap": {
                                  "op": "setState",
                                  "id": "themeId",
                                  "value": "ocean"
                                },
                                "child": {
                                  "type": "container",
                                  "direction": "column",
                                  "gap": 8,
                                  "children": [
                                    {
                                      "type": "row",
                                      "gap": 8,
                                      "children": [
                                        {
                                          "type": "sized_box",
                                          "id": "swatch-ocean-canvas",
                                          "width": 40,
                                          "height": 24,
                                          "color": "#17212b"
                                        },
                                        {
                                          "type": "sized_box",
                                          "id": "swatch-ocean-accent",
                                          "width": 40,
                                          "height": 24,
                                          "color": "#70b9ee"
