                    },
                    {
                      "type": "segmented",
                      "id": "appearance",
                      "segments": [
                        {
                          "label": "System",
                          "value": "system"
                        },
                        {
                          "label": "Light",
                          "value": "light"
                        },
                        {
                          "label": "Dark",
                          "value": "dark"
                        }
                      ],
                      "value": "dark"
                    },
                    {
                      "type": "input",
                      "id": "canvas",
                      "label": "Canvas",
                      "value": "#17212b",
                      "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
                      "errorText": "Use #RRGGBB or #AARRGGBB"
                    },
                    {
                      "type": "input",
                      "id": "accent",
                      "label": "Accent",
                      "value": "#70b9ee",
                      "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
                      "errorText": "Use #RRGGBB or #AARRGGBB"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "card",
          "id": "section-interface",
          "title": "Interface",
          "children": [
            {
              "type": "switch",
              "id": "fold_interface",
              "label": "Interface",
              "value": false,
              "visible": false
            },
            {
              "type": "row",
              "id": "section-interface-toggle",
              "align": "center",
              "gap": 8,
              "when": "fold_interface != true",
              "onTap": {
                "op": "setState",
                "id": "fold_interface",
                "value": true
              },
              "children": [
                {
                  "type": "icon",
                  "icon": "chevron_right",
                  "size": 16,
                  "color": "$color.muted-foreground"
                },
                {
                  "type": "text",
                  "text": "Contrast, chat width and diff colors",
                  "style": "caption"
                }
              ]
            },
            {
              "type": "row",
              "id": "section-interface-toggle-open",
              "align": "center",
              "gap": 8,
              "when": "fold_interface == true",
              "onTap": {
                "op": "setState",
                "id": "fold_interface",
                "value": false
              },
              "children": [
                {
                  "type": "icon",
                  "icon": "expand_more",
                  "size": 16,
                  "color": "$color.muted-foreground"
                },
                {
                  "type": "text",
                  "text": "Contrast, chat width and diff colors",
                  "style": "caption"
                }
              ]
            },
            {
              "type": "container",
              "id": "section-interface-body",
              "direction": "column",
              "gap": 8,
              "when": "fold_interface == true",
              "children": [
                {
                  "type": "container",
                  "direction": "column",
                  "gap": 8,
                  "children": [
                    {
                      "type": "slider",
                      "id": "contrastBoost",
                      "min": 0.0,
                      "max": 100.0,
                      "label": "Contrast boost",
                      "step": 5.0,
                      "value": 100.0,
                      "demo": true
                    },
                    {
                      "type": "segmented",
                      "id": "chatWidth",
                      "value": "default",
                      "segments": [
                        {
                          "label": "Default",
                          "value": "default"
                        },
                        {
                          "label": "Wide",
                          "value": "wide"
                        },
                        {
                          "label": "Full",
                          "value": "full"
                        }
                      ],
                      "action": {
                        "client": [
                          {
                            "op": "toast",
                            "text": "Preview only — not saved in this build"
                          }
                        ]
                      },
                      "demo": true
                    },
                    {
                      "type": "switch",
                      "id": "diffColorScheme",
                      "label": "Blue & orange diff colors",
                      "value": false,
                      "demo": true
                    },
                    {
                      "type": "segmented",
                      "id": "density",
                      "segments": [
                        {
                          "label": "Compact",
                          "value": "compact"
                        },
                        {
                          "label": "Comfortable",
                          "value": "comfortable"
                        },
                        {
                          "label": "Spacious",
                          "value": "spacious"
                        }
                      ],
                      "value": "compact"
                    },
                    {
                      "type": "text",
                      "text": "Reduced motion follows your operating system and disables panel animations.",
                      "id": "reducedMotionNote",
                      "style": "caption"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "card",
          "id": "section-typography",
          "title": "Typography",
          "children": [
            {
              "type": "switch",
              "id": "fold_typography",
