                {
                  "type": "text",
                  "text": "Interface, prompt and code fonts",
                  "style": "caption"
                }
              ]
            },
            {
              "type": "container",
              "id": "section-typography-body",
              "direction": "column",
              "gap": 8,
              "when": "fold_typography == true",
              "children": [
                {
                  "type": "container",
                  "direction": "column",
                  "gap": 8,
                  "children": [
                    {
                      "type": "slider",
                      "id": "fontSizeInterface",
                      "min": 12.0,
                      "max": 20.0,
                      "label": "Interface font size",
                      "step": 1.0,
                      "value": 16.0,
                      "demo": true
                    },
                    {
                      "type": "slider",
                      "id": "fontSizePrompt",
                      "min": 12.0,
                      "max": 20.0,
                      "label": "Prompt font size",
                      "step": 1.0,
                      "value": 14.0,
                      "demo": true
                    },
                    {
                      "type": "slider",
                      "id": "fontSizeCode",
                      "min": 10.0,
                      "max": 18.0,
                      "label": "Code font size",
                      "step": 1.0,
                      "value": 13.0,
                      "demo": true
                    },
                    {
                      "type": "input",
                      "id": "fontFamilySans",
                      "label": "Interface font",
                      "value": "System default",
                      "demo": true
                    },
                    {
                      "type": "input",
                      "id": "fontFamilyCode",
                      "label": "Code font",
                      "value": "System monospace",
                      "demo": true
                    },
                    {
                      "type": "input",
                      "id": "fontFamilyComposer",
                      "label": "Prompt font",
                      "value": "System default",
                      "demo": true
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "card",
          "id": "section-motion",
          "title": "Motion",
          "children": [
            {
              "type": "switch",
              "id": "fold_motion",
              "label": "Motion",
              "value": false,
              "visible": false
            },
            {
              "type": "row",
              "id": "section-motion-toggle",
              "align": "center",
              "gap": 8,
              "when": "fold_motion != true",
              "onTap": {
                "op": "setState",
                "id": "fold_motion",
                "value": true
              },
              "children": [
                {
                  "type": "icon",
                  "icon": "chevron_right",
                  "size": 16,
                  "color": "$color.muted-foreground"
                },
                {
                  "type": "text",
                  "text": "Panel open and close speed",
                  "style": "caption"
                }
              ]
            },
            {
              "type": "row",
              "id": "section-motion-toggle-open",
              "align": "center",
              "gap": 8,
              "when": "fold_motion == true",
              "onTap": {
                "op": "setState",
                "id": "fold_motion",
                "value": false
              },
              "children": [
                {
                  "type": "icon",
                  "icon": "expand_more",
                  "size": 16,
                  "color": "$color.muted-foreground"
                },
                {
                  "type": "text",
                  "text": "Panel open and close speed",
                  "style": "caption"
                }
              ]
            },
            {
              "type": "container",
              "id": "section-motion-body",
              "direction": "column",
              "gap": 8,
              "when": "fold_motion == true",
              "children": [
                {
                  "type": "container",
                  "direction": "column",
                  "gap": 8,
                  "children": [
                    {
                      "type": "slider",
                      "id": "panelMotionMs",
                      "min": 0.0,
                      "max": 400.0,
                      "label": "Panel animations",
                      "step": 20.0,
                      "value": 200.0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "button",
          "label": "Save",
          "action": {
            "path": "/ui/action/save-appearance",
            "method": "POST",
            "name": "save-appearance",
            "include": [
              "appearance",
              "themeId",
              "canvas",
              "accent",
              "density",
              "panelMotionMs"
            ]
          }
        }
      ]
    }
  }
}
