                                    }
                                  ]
                                }
                              }
                            }
                          ]
                        },
                        {
                          "type": "row",
                          "gap": 8,
                          "children": [
                            {
                              "type": "expanded",
                              "child": {
                                "type": "box",
                                "id": "theme-ember",
                                "padding": "$spacing.md",
                                "borderRadius": "$radius.md",
                                "borderWidth": 1,
                                "border": "$color.border",
                                "onTap": {
                                  "op": "setState",
                                  "id": "themeId",
                                  "value": "ember"
                                },
                                "child": {
                                  "type": "container",
                                  "direction": "column",
                                  "gap": 8,
                                  "children": [
                                    {
                                      "type": "row",
                                      "gap": 8,
                                      "children": [
                                        {
                                          "type": "sized_box",
                                          "id": "swatch-ember-canvas",
                                          "width": 40,
                                          "height": 24,
                                          "color": "#291e1a"
                                        },
                                        {
                                          "type": "sized_box",
                                          "id": "swatch-ember-accent",
                                          "width": 40,
                                          "height": 24,
                                          "color": "#f09a64"
                                        }
                                      ]
                                    },
                                    {
                                      "type": "text",
                                      "text": "Ember",
                                      "style": "body"
                                    },
                                    {
                                      "type": "row",
                                      "gap": 8,
                                      "children": [
                                        {
                                          "type": "chip",
                                          "label": "Light",
                                          "avatar": {
                                            "type": "sized_box",
                                            "id": "chip-ember-light",
                                            "width": 40,
                                            "height": 24,
                                            "color": "#ae552a"
                                          }
                                        },
                                        {
                                          "type": "chip",
                                          "label": "Dark",
                                          "avatar": {
                                            "type": "sized_box",
                                            "id": "chip-ember-dark",
                                            "width": 40,
                                            "height": 24,
                                            "color": "#f09a64"
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                }
                              }
                            },
                            {
                              "type": "expanded",
                              "child": {
                                "type": "box",
                                "id": "theme-iris",
                                "padding": "$spacing.md",
                                "borderRadius": "$radius.md",
                                "borderWidth": 1,
                                "border": "$color.border",
                                "onTap": {
                                  "op": "setState",
                                  "id": "themeId",
                                  "value": "iris"
