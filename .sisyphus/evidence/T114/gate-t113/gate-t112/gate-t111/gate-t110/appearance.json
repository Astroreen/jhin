                                    {
                                      "type": "text",
                                      "text": "Iris",
                                      "style": "body"
                                    },
                                    {
                                      "type": "row",
                                      "gap": 8,
                                      "children": [
                                        {
                                          "type": "chip",
                                          "label": "Light",
                                          "avatar": {
                                            "type": "sized_box",
                                            "id": "chip-iris-light",
                                            "width": 40,
                                            "height": 24,
                                            "color": "#7253b9"
                                          }
                                        },
                                        {
                                          "type": "chip",
                                          "label": "Dark",
                                          "avatar": {
                                            "type": "sized_box",
                                            "id": "chip-iris-dark",
                                            "width": 40,
                                            "height": 24,
                                            "color": "#9d7df2"
                                          }
