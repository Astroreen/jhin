                                      ]
                                    },
                                    {
                                      "type": "text",
                                      "text": "Ocean",
                                      "style": "body"
                                    },
                                    {
                                      "type": "row",
                                      "gap": 8,
                                      "children": [
                                        {
                                          "type": "chip",
                                          "label": "Light",
                                          "avatar": {
                                            "type": "sized_box",
