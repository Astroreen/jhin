{
  "type": "screen",
  "title": "Sessions",
  "body": {
    "type": "shell",
    "id": "sessions-shell",
    "breakpoint": 768,
    "topbar": {
      "type": "row",
      "id": "shell-topbar",
      "align": "center",
      "children": [
        {
          "type": "text",
          "text": "Jhin",
          "style": "h3",
          "bold": true
        },
        {
          "type": "row",
          "id": "shell-breadcrumb",
          "align": "center",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "text": "Workspace",
              "style": "small"
            },
            {
              "type": "text",
              "text": "/",
              "style": "small"
            },
            {
              "type": "text",
              "text": "Threads",
              "style": "body",
              "bold": true
            }
          ]
        },
        {
          "type": "spacer"
        },
        {
          "type": "nav",
          "kind": "tabs",
          "items": [
            {
              "label": "Sessions",
              "screen": "sessions"
            },
            {
              "label": "Settings",
              "screen": "settings"
            },
            {
              "label": "Plugins",
              "screen": "plugins"
            },
            {
              "label": "Providers",
              "screen": "providers"
            }
          ],
          "activeIndex": 0
        }
      ]
    },
    "topbarCompact": {
      "type": "row",
      "id": "shell-topbar-compact",
      "align": "center",
      "children": [
        {
          "type": "text",
          "text": "Jhin",
          "style": "h3",
          "bold": true
        },
        {
          "type": "text",
          "text": "Threads",
          "style": "body"
        },
        {
          "type": "spacer"
        }
      ]
    },
    "pageHeader": {
      "type": "row",
      "id": "shell-page-header",
      "align": "center",
      "children": [
        {
          "type": "text",
          "text": "Threads",
          "style": "h3"
        },
        {
          "type": "spacer"
        },
        {
          "type": "button",
          "label": "Arrange threads",
          "style": "secondary",
          "action": {
            "path": "/ui/action/arrange-toggle",
            "method": "POST",
            "name": "arrange-toggle",
            "payload": {
              "arrange": true
            }
          }
        }
      ]
    },
    "stageBackdrop": true,
    "body": {
      "type": "column",
      "id": "sidebar-split",
      "children": [
        {
          "type": "list",
          "id": "sidebar-sections",
          "sections": [
            {
              "label": "Pinned",
              "id": "section-pinned",
              "collapsible": true,
              "collapsed": false,
              "count": 0,
              "badgeStyle": "sidebar-control-surface",
              "uppercase": true,
              "storeKey": "sidebar.section.pinned.collapsed",
              "boundaryLabel": "Pinned",
              "items": []
            },
            {
              "label": "Active",
              "id": "section-active",
              "collapsible": true,
              "collapsed": false,
              "count": 1,
              "badgeStyle": "sidebar-control-surface",
              "uppercase": true,
              "storeKey": "sidebar.section.active.collapsed",
              "boundaryLabel": "Active",
              "items": [
                {
                  "type": "list_row",
                  "id": "session-row:1c2c2a2f-fd26-41bf-879e-5fb4996a8f27",
                  "title": {
                    "type": "text",
                    "text": "t120-e2e",
                    "fontSize": 14,
                    "fontWeight": 600,
                    "maxLines": 1,
                    "ellipsis": true
                  },
                  "subtitle": {
                    "type": "row",
                    "align": "center",
                    "gap": 4,
                    "children": [
                      {
                        "type": "text",
                        "text": "/tmp/t120",
                        "style": "caption",
                        "color": "$color.sidebar-muted-foreground",
                        "maxLines": 1,
                        "ellipsis": true,
                        "flex": 1
                      },
                      {
                        "type": "box",
                        "id": "thread-context-chip",
                        "padding": {
                          "bottom": 2,
                          "right": 6,
                          "top": 2,
                          "left": 6
                        },
                        "border": "$color.border",
                        "borderRadius": "$radius.sm",
                        "tooltip": "Project: /tmp/t120",
                        "child": {
                          "type": "text",
                          "text": "t120",
                          "fontSize": 12,
                          "maxLines": 1,
                          "ellipsis": true
                        }
                      }
                    ]
                  },
                  "trailing": {
                    "type": "menu",
                    "trigger": {
                      "type": "icon_button",
                      "icon": "more_vert",
                      "action": {
                        "path": "/ui/action/noop",
                        "method": "POST",
                        "name": "noop"
                      }
                    },
                    "items": [
                      {
                        "label": "Pin thread",
                        "icon": "keep",
                        "action": {
                          "path": "/ui/action/pin",
                          "method": "POST",
                          "name": "pin",
                          "payload": {
                            "id": "1c2c2a2f-fd26-41bf-879e-5fb4996a8f27"
                          }
                        }
                      },
                      {
                        "label": "Settle thread",
                        "icon": "check_circle",
                        "action": {
                          "path": "/ui/action/settle",
                          "method": "POST",
                          "name": "settle",
                          "payload": {
                            "id": "1c2c2a2f-fd26-41bf-879e-5fb4996a8f27"
                          }
                        }
                      },
                      {
                        "label": "Snooze",
                        "icon": "schedule",
                        "children": [
                          {
                            "label": "In 1 hour (5:02 PM)",
                            "action": {
                              "path": "/ui/action/snooze",
                              "method": "POST",
                              "name": "snooze",
                              "payload": {
                                "until": 1791295347784,
                                "id": "1c2c2a2f-fd26-41bf-879e-5fb4996a8f27"
                              }
                            }
                          },
                          {
                            "label": "In 3 hours (7:02 PM)",
                            "action": {
                              "path": "/ui/action/snooze",
                              "method": "POST",
                              "name": "snooze",
                              "payload": {
                                "until": 1791302547784,
                                "id": "1c2c2a2f-fd26-41bf-879e-5fb4996a8f27"
                              }
                            }
                          },
                          {
                            "label": "This evening (6:00 PM)",
                            "action": {
                              "path": "/ui/action/snooze",
                              "method": "POST",
                              "name": "snooze",
                              "payload": {
                                "until": 1791298800000,
                                "id": "1c2c2a2f-fd26-41bf-879e-5fb4996a8f27"
                              }
                            }
                          },
                          {
                            "label": "Tomorrow (9:00 AM)",
                            "action": {
                              "path": "/ui/action/snooze",
                              "method": "POST",
                              "name": "snooze",
                              "payload": {
                                "until": 1791352800000,
                                "id": "1c2c2a2f-fd26-41bf-879e-5fb4996a8f27"
                              }
                            }
                          },
                          {
                            "label": "Next week (Mon 9:00 AM)",
                            "action": {
                              "path": "/ui/action/snooze",
                              "method": "POST",
                              "name": "snooze",
                              "payload": {
                                "until": 1791784800000,
                                "id": "1c2c2a2f-fd26-41bf-879e-5fb4996a8f27"
                              }
                            }
                          },
                          {
                            "label": "Custom…",
                            "separatorBefore": true,
                            "action": {
                              "op": "dialog",
                              "node": {
                                "type": "column",
                                "id": "custom-snooze-dialog",
                                "gap": 12,
                                "demo": true,
                                "children": [
                                  {
                                    "type": "text",
                                    "text": "Custom snooze",
                                    "style": "h3"
                                  },
                                  {
                                    "type": "form",
                                    "fields": [
                                      {
                                        "type": "input",
                                        "id": "customSnoozeHours",
                                        "label": "Hours from now",
                                        "required": true,
                                        "errorText": "A number of hours is required"
                                      }
                                    ],
                                    "submit": {
                                      "label": "Confirm",
                                      "action": {
                                        "path": "/ui/action/demo-snooze",
                                        "method": "POST",
                                        "name": "demo-snooze"
                                      }
                                    }
                                  },
                                  {
                                    "type": "button",
                                    "label": "Cancel",
                                    "style": "text",
                                    "action": {
                                      "op": "dismissDialog"
                                    }
                                  }
                                ]
                              }
                            }
                          }
                        ]
                      },
                      {
                        "label": "Regenerate title",
                        "icon": "refresh",
                        "separatorBefore": true,
                        "action": {
                          "path": "/ui/action/regenerate-title",
                          "method": "POST",
                          "name": "regenerate-title",
                          "payload": {
                            "id": "1c2c2a2f-fd26-41bf-879e-5fb4996a8f27"
                          }
                        }
                      },
                      {
                        "label": "Auto-settle behavior",
                        "icon": "timer",
                        "children": [
                          {
                            "label": "Enabled",
                            "checked": true,
                            "action": {
                              "path": "/ui/action/auto-settle",
                              "method": "POST",
                              "name": "auto-settle",
                              "payload": {
                                "enabled": true,
                                "id": "1c2c2a2f-fd26-41bf-879e-5fb4996a8f27"
                              }
                            }
                          },
                          {
                            "label": "Disabled",
                            "checked": false,
                            "action": {
                              "path": "/ui/action/auto-settle",
                              "method": "POST",
                              "name": "auto-settle",
                              "payload": {
                                "enabled": false,
                                "id": "1c2c2a2f-fd26-41bf-879e-5fb4996a8f27"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "label": "Arrange threads",
                        "icon": "drag_handle",
                        "action": {
                          "op": "dialog",
                          "node": {
                            "type": "sheet",
                            "title": "Arrange threads",
                            "body": {
                              "type": "column",
                              "id": "arrange-sheet-body",
                              "gap": 4,
                              "children": [
                                {
                                  "type": "list_row",
                                  "title": "t120-e2e",
                                  "dragHandle": true
                                }
                              ]
                            },
                            "footer": {
                              "type": "row",
                              "align": "center",
                              "children": [
                                {
                                  "type": "spacer"
                                },
                                {
                                  "type": "button",
                                  "label": "Done",
                                  "style": "primary",
                                  "action": {
                                    "op": "dismissDialog"
                                  }
                                }
                              ]
                            },
                            "demo": true
                          },
                          "kind": "sheet"
                        }
                      },
                      {
                        "label": "Archive thread",
                        "icon": "archive",
                        "separatorBefore": true,
                        "action": {
                          "path": "/ui/action/archive",
                          "method": "POST",
                          "name": "archive",
                          "payload": {
                            "id": "1c2c2a2f-fd26-41bf-879e-5fb4996a8f27"
                          }
                        },
                        "confirm": "Archive this thread?"
                      },
                      {
                        "label": "Delete",
                        "icon": "delete",
                        "action": {
                          "path": "/ui/action/delete-session",
                          "method": "POST",
                          "name": "delete-session",
                          "payload": {
                            "id": "1c2c2a2f-fd26-41bf-879e-5fb4996a8f27"
                          }
                        },
                        "confirm": "Delete this thread? This cannot be undone.",
                        "danger": true
                      }
                    ]
                  },
                  "statusIndicators": [
                    "idle"
                  ],
                  "hoverReveal": true,
                  "searchMatch": {
                    "minChars": 2,
                    "key": "sidebarSearch"
                  },
                  "dragHandle": false,
                  "action": {
                    "op": "navigate",
                    "screen": "chat:1c2c2a2f-fd26-41bf-879e-5fb4996a8f27"
                  },
                  "draggable": true,
                  "dragLabel": {
                    "type": "row",
                    "id": "drag-label",
                    "gap": 4,
                    "children": [
                      {
                        "type": "icon",
                        "icon": "push_pin",
                        "size": 12
                      },
                      {
                        "type": "text",
                        "text": "Pin",
                        "fontSize": 12,
                        "fontWeight": 500
                      }
                    ]
                  },
                  "dropTargets": [
                    {
                      "id": "section-pinned",
                      "label": "Pin",
                      "accentWhenHovered": true,
                      "action": {
                        "path": "/ui/action/pin",
                        "method": "POST",
                        "name": "pin",
                        "payload": {
                          "id": "1c2c2a2f-fd26-41bf-879e-5fb4996a8f27"
                        }
                      }
                    },
                    {
                      "id": "section-settled",
                      "label": "Settle",
                      "accentWhenHovered": true,
                      "action": {
                        "path": "/ui/action/settle",
                        "method": "POST",
                        "name": "settle",
                        "payload": {
                          "id": "1c2c2a2f-fd26-41bf-879e-5fb4996a8f27"
                        }
                      }
                    }
                  ],
                  "workdir": "/tmp/t120",
                  "status": "active",
                  "pinned": false,
                  "pinnedOrder": null,
                  "settledAt": null,
                  "snoozedUntil": null,
                  "archivedAt": null,
                  "settledReason": null,
                  "sortOrder": null
                }
              ]
            },
            {
              "label": "Working",
              "id": "section-working",
              "collapsible": true,
              "collapsed": false,
              "count": 0,
              "badgeStyle": "sidebar-control-surface",
              "uppercase": true,
              "storeKey": "sidebar.section.working.collapsed",
              "when": "workingSection != false",
              "items": []
            },
            {
              "label": "Snoozed",
              "id": "section-snoozed",
              "collapsible": true,
              "collapsed": true,
              "count": 0,
              "badgeStyle": "sidebar-control-surface",
              "uppercase": true,
              "storeKey": "sidebar.section.snoozed.collapsed",
              "items": []
            },
            {
              "label": "Settled",
              "id": "section-settled",
              "collapsible": true,
              "collapsed": true,
              "count": 0,
              "badgeStyle": "sidebar-control-surface",
              "uppercase": true,
              "storeKey": "sidebar.section.settled.collapsed",
              "items": []
            }
          ],
          "header": {
            "type": "column",
            "id": "sidebar-header",
            "gap": 8,
            "children": [
              {
                "type": "row",
                "id": "sidebar-brand",
                "align": "center",
                "children": [
                  {
                    "type": "text",
                    "text": "Jhin",
                    "style": "h3",
                    "bold": true
                  },
                  {
                    "type": "spacer"
                  },
                  {
                    "type": "icon_button",
                    "icon": "chevron_right",
                    "demo": true
                  }
                ]
              },
              {
                "type": "row",
                "id": "sidebar-search",
                "align": "center",
                "gap": 8,
                "children": [
                  {
                    "type": "input",
                    "id": "sidebarSearch",
                    "placeholder": "Search threads",
                    "flex": 1
                  },
                  {
                    "type": "button",
                    "label": "New thread",
                    "style": "primary",
                    "icon": "add",
                    "action": {
                      "op": "dialog",
                      "node": {
                        "type": "column",
                        "id": "new-thread-dialog",
                        "gap": 12,
                        "children": [
                          {
                            "type": "text",
                            "text": "New thread",
                            "style": "h3"
                          },
                          {
                            "type": "form",
                            "fields": [
                              {
                                "type": "input",
                                "id": "newThreadTitle",
                                "label": "Title",
                                "required": true,
                                "errorText": "A title is required"
                              },
                              {
                                "type": "input",
                                "id": "newThreadWorkdir",
                                "label": "Working directory",
                                "required": true,
                                "errorText": "A working directory is required"
                              }
                            ],
                            "submit": {
                              "label": "Create thread",
                              "action": {
                                "path": "/ui/action/create-session",
                                "method": "POST",
                                "name": "create-session",
                                "include": [
                                  "newThreadTitle",
                                  "newThreadWorkdir"
                                ]
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          },
          "footer": {
            "type": "row",
            "id": "sidebar-footer",
            "align": "center",
            "gap": 8,
            "children": [
              {
                "type": "row",
                "id": "sidebar-status-dot",
                "align": "center",
                "gap": 4,
                "tooltip": "Online",
                "children": [
                  {
                    "type": "box",
                    "width": 8,
                    "height": 8,
                    "color": "$color.success",
                    "shape": "circle"
                  },
                  {
                    "type": "text",
                    "text": "Online",
                    "style": "caption"
                  }
                ]
              },
              {
                "type": "avatar",
                "initials": "D1",
                "size": 20,
                "shape": "circle"
              },
              {
                "type": "text",
                "text": "d1743aea-25f6-4e84-9bad-d484863a180f",
                "style": "small",
                "flex": 1
              },
              {
                "type": "icon_button",
                "icon": "settings",
                "tooltip": "Settings",
                "action": {
                  "op": "navigate",
                  "screen": "settings"
                }
              },
              {
                "type": "icon_button",
                "icon": "person",
                "tooltip": "Switch profile",
                "action": {
                  "op": "openProfiles"
                }
              }
            ]
          },
          "search": {
            "fields": [
              "title",
              "subtitle"
            ],
            "key": "sidebarSearch"
          }
        },
        {
          "type": "card",
          "title": "Select a thread",
          "children": [
            {
              "type": "text",
              "text": "Choose a thread from the sidebar to open the conversation.",
              "style": "caption"
            }
          ]
        }
      ]
    },
    "terminal": {
      "type": "container",
      "id": "terminal-drawer",
      "direction": "column",
      "gap": 0,
      "when": "chat_terminal == true",
      "color": "$color.code",
      "border": "$color.border",
      "borderWidth": 1,
      "initialHeight": 240,
      "minDrawerHeight": 100,
      "maxDrawerRatio": 0.5,
      "persistKey": "terminal_height",
      "closeState": "chat_terminal",
      "cursorColor": "$color.foreground",
      "selectionColor": "$color.accent",
      "children": [
        {
          "type": "row",
          "id": "terminal-drawer-header",
          "align": "center",
          "gap": 8,
          "padding": [
            4,
            8
          ],
          "children": [
            {
              "type": "icon",
              "id": "terminal-drawer-grip",
              "icon": "drag_indicator",
              "size": 16,
              "color": "$color.code-foreground"
            },
            {
              "type": "text",
              "text": "Terminal",
              "fontSize": 12,
              "fontWeight": 600,
              "color": "$color.code-foreground"
            },
            {
              "type": "spacer"
            },
            {
              "type": "icon_button",
              "id": "terminal-drawer-close",
              "icon": "close",
              "iconSize": 16,
              "constraints": {
                "minWidth": 24,
                "minHeight": 24
              },
              "tooltip": "Close terminal",
              "action": {
                "op": "setState",
                "id": "chat_terminal",
                "value": false
              }
            }
          ]
        },
        {
          "type": "expanded",
          "flex": 1,
          "child": {
            "type": "scroll",
            "items": [
              {
                "type": "code_block",
                "code": "$ jhin status\njhin 0.3.0 - kernel healthy\nplugins: 12 loaded\n$ jhin sessions list\ns-1  Fix the login bug        active\ns-2  Add OAuth callback       settled\n$ jhin plugins\njhin.sessions       0.3.0\njhin.security       0.3.0\njhin.llm            0.3.0\njhin.agent          0.3.0\njhin.tools-builtin  0.3.0\njhin.mcp            0.3.0\njhin.ui-kit         0.3.0\njhin.ui             0.3.0\njhin.reload         0.3.0\njhin.qa-mock-llm    0.3.0\n$ jhin health\nok\n$ ",
                "id": "terminal-drawer-transcript",
                "language": "shell",
                "wrap": false,
                "syntax": true
              }
            ]
          }
        }
      ]
    }
  }
}
