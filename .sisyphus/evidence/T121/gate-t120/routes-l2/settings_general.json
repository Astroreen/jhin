{
  "type": "screen",
  "title": "Settings",
  "body": {
    "type": "shell",
    "id": "settings-shell",
    "breakpoint": 768,
    "topbar": {
      "type": "row",
      "id": "settings-topbar",
      "align": "center",
      "children": [
        {
          "type": "text",
          "text": "Jhin",
          "style": "h3",
          "bold": true
        },
        {
          "type": "spacer"
        },
        {
          "type": "button",
          "label": "Back to threads",
          "style": "secondary",
          "action": {
            "op": "navigate",
            "screen": "sessions"
          }
        }
      ]
    },
    "topbarCompact": {
      "type": "row",
      "id": "settings-topbar-compact",
      "align": "center",
      "children": [
        {
          "type": "text",
          "text": "Jhin",
          "style": "h3",
          "bold": true
        },
        {
          "type": "spacer"
        }
      ]
    },
    "pageHeader": {
      "type": "row",
      "id": "settings-breadcrumb",
      "align": "center",
      "gap": 8,
      "children": [
        {
          "type": "text",
          "text": "Settings",
          "style": "small"
        },
        {
          "type": "text",
          "text": "/",
          "style": "small"
        },
        {
          "type": "text",
          "text": "General",
          "style": "body",
          "bold": true
        }
      ]
    },
    "sidebar": {
      "type": "nav",
      "id": "settings-nav",
      "kind": "sidebar",
      "items": [
        {
          "id": "settings:general",
          "label": "General",
          "icon": "settings",
          "screen": "settings:general"
        },
        {
          "id": "settings:appearance",
          "label": "Appearance",
          "icon": "palette",
          "screen": "settings:appearance"
        },
        {
          "id": "settings:keybindings",
          "label": "Keybindings",
          "icon": "keyboard",
          "screen": "settings:keybindings"
        },
        {
          "id": "settings:providers",
          "label": "Providers",
          "icon": "smart_toy",
          "screen": "settings:providers"
        },
        {
          "id": "settings:connections",
          "label": "Connections",
          "icon": "link",
          "screen": "settings:connections"
        },
        {
          "id": "settings:integrations",
          "label": "Integrations",
          "icon": "extension",
          "screen": "settings:integrations"
        },
        {
          "id": "settings:diagnostics",
          "label": "Diagnostics",
          "icon": "monitor_heart",
          "screen": "settings:diagnostics"
        },
        {
          "id": "settings:storage",
          "label": "Storage",
          "icon": "storage",
          "screen": "settings:storage"
        },
        {
          "id": "settings:archived",
          "label": "Archive",
          "icon": "archive",
          "screen": "settings:archived"
        },
        {
          "id": "settings:projects",
          "label": "Project",
          "icon": "folder",
          "screen": "settings:projects"
        },
        {
          "id": "settings:scheduled-tasks",
          "label": "Scheduled Tasks",
          "icon": "schedule",
          "screen": "settings:scheduled-tasks"
        },
        {
          "id": "settings:source-control",
          "label": "Source Control",
          "icon": "account_tree",
          "screen": "settings:source-control"
        },
        {
          "id": "settings:snap-shot",
          "label": "SnapShots",
          "icon": "photo_camera",
          "screen": "settings:snap-shot"
        },
        {
          "id": "settings:licenses",
          "label": "Open source licenses",
          "icon": "description",
          "screen": "settings:licenses"
        }
      ],
      "activeId": "settings:general"
    },
    "stageBackdrop": true,
    "body": {
      "type": "container",
      "direction": "column",
      "gap": 12,
      "padding": 16,
      "children": [
        {
          "type": "card",
          "id": "section-general",
          "title": "General",
          "children": [
            {
              "type": "switch",
              "id": "fold_general",
              "label": "General",
              "value": false,
              "visible": false,
              "demo": true
            },
            {
              "type": "row",
              "id": "section-general-toggle",
              "align": "center",
              "gap": 8,
              "when": "fold_general != true",
              "onTap": {
                "op": "setState",
                "id": "fold_general",
                "value": true
              },
              "children": [
                {
                  "type": "icon",
                  "icon": "chevron_right",
                  "size": 16,
                  "color": "$color.muted-foreground"
                },
                {
                  "type": "text",
                  "text": "Send shortcut, follow-ups and limited threads",
                  "style": "caption"
                }
              ]
            },
            {
              "type": "row",
              "id": "section-general-toggle-open",
              "align": "center",
              "gap": 8,
              "when": "fold_general == true",
              "onTap": {
                "op": "setState",
                "id": "fold_general",
                "value": false
              },
              "children": [
                {
                  "type": "icon",
                  "icon": "expand_more",
                  "size": 16,
                  "color": "$color.muted-foreground"
                },
                {
                  "type": "text",
                  "text": "Send shortcut, follow-ups and limited threads",
                  "style": "caption"
                }
              ]
            },
            {
              "type": "container",
              "id": "section-general-body",
              "direction": "column",
              "gap": 8,
              "when": "fold_general == true",
              "children": [
                {
                  "type": "container",
                  "direction": "column",
                  "gap": 8,
                  "children": [
                    {
                      "type": "dropdown",
                      "id": "sendShortcut",
                      "hint": "Choose when Enter sends a prompt or inserts a new line",
                      "value": "enter",
                      "items": [
                        {
                          "label": "Enter",
                          "value": "enter"
                        },
                        {
                          "label": "Ctrl + Enter for multiline prompts",
                          "value": "mod-enter-multiline"
                        },
                        {
                          "label": "Ctrl + Enter always",
                          "value": "mod-enter"
                        }
                      ],
                      "action": {
                        "client": [
                          {
                            "op": "toast",
                            "text": "Preview only — not saved in this build"
                          }
                        ]
                      },
                      "demo": true
                    },
                    {
                      "type": "dropdown",
                      "id": "followUpBehavior",
                      "hint": "Queue follow-ups while the agent runs or steer the current run",
                      "value": "queue",
                      "items": [
                        {
                          "label": "Queue",
                          "value": "queue"
                        },
                        {
                          "label": "Steer",
                          "value": "steer"
                        }
                      ],
                      "action": {
                        "client": [
                          {
                            "op": "toast",
                            "text": "Preview only — not saved in this build"
                          }
                        ]
                      },
                      "demo": true
                    },
                    {
                      "type": "switch",
                      "id": "autoResumeLimitedThreads",
                      "label": "Auto-resume limited threads",
                      "value": true,
                      "demo": true
                    },
                    {
                      "type": "switch",
                      "id": "snoozeLimitedThreads",
                      "label": "Snooze limited threads",
                      "value": false,
                      "demo": true
                    },
                    {
                      "type": "switch",
                      "id": "workingSection",
                      "label": "Working section (beta)",
                      "value": true,
                      "demo": true
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "card",
          "id": "section-thread-behavior",
          "title": "Thread behavior",
          "children": [
            {
              "type": "switch",
              "id": "fold_thread_behavior",
              "label": "Thread behavior",
              "value": false,
              "visible": false,
              "demo": true
            },
            {
              "type": "row",
              "id": "section-thread-behavior-toggle",
              "align": "center",
              "gap": 8,
              "when": "fold_thread_behavior != true",
              "onTap": {
                "op": "setState",
                "id": "fold_thread_behavior",
                "value": true
              },
              "children": [
                {
                  "type": "icon",
                  "icon": "chevron_right",
                  "size": 16,
                  "color": "$color.muted-foreground"
                },
                {
                  "type": "text",
                  "text": "Auto-settle rules and inactivity",
                  "style": "caption"
                }
              ]
            },
            {
              "type": "row",
              "id": "section-thread-behavior-toggle-open",
              "align": "center",
              "gap": 8,
              "when": "fold_thread_behavior == true",
              "onTap": {
                "op": "setState",
                "id": "fold_thread_behavior",
                "value": false
              },
              "children": [
                {
                  "type": "icon",
                  "icon": "expand_more",
                  "size": 16,
                  "color": "$color.muted-foreground"
                },
                {
                  "type": "text",
                  "text": "Auto-settle rules and inactivity",
                  "style": "caption"
                }
              ]
            },
            {
              "type": "container",
              "id": "section-thread-behavior-body",
              "direction": "column",
              "gap": 8,
              "when": "fold_thread_behavior == true",
              "children": [
                {
                  "type": "container",
                  "direction": "column",
                  "gap": 8,
                  "children": [
                    {
                      "type": "dropdown",
                      "id": "autoSettleRules",
                      "hint": "All environments — mixed across selected environments",
                      "value": "all",
                      "items": [
                        {
                          "label": "All environments",
                          "value": "all"
                        },
                        {
                          "label": "Local",
                          "value": "local"
                        },
                        {
                          "label": "Remote",
                          "value": "remote"
                        }
                      ],
                      "action": {
                        "client": [
                          {
                            "op": "toast",
                            "text": "Preview only — not saved in this build"
                          }
                        ]
                      },
                      "demo": true
                    },
                    {
                      "type": "switch",
                      "id": "autoSettleDefault",
                      "label": "Auto-settle inactive threads",
                      "value": true
                    },
                    {
                      "type": "slider",
                      "id": "inactivityDays",
                      "min": 1.0,
                      "max": 30.0,
                      "label": "Default settle days",
                      "step": 1.0,
                      "value": 3.0
                    },
                    {
                      "type": "switch",
                      "id": "settleOnPrMerged",
                      "label": "Settle on PR merged",
                      "value": false,
                      "enabled": false,
                      "tooltip": "PR linking is not enabled"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "card",
          "id": "section-confirmations",
          "title": "Confirmations",
          "children": [
            {
              "type": "switch",
              "id": "fold_confirmations",
              "label": "Confirmations",
              "value": false,
              "visible": false,
              "demo": true
            },
            {
              "type": "row",
              "id": "section-confirmations-toggle",
              "align": "center",
              "gap": 8,
              "when": "fold_confirmations != true",
              "onTap": {
                "op": "setState",
                "id": "fold_confirmations",
                "value": true
              },
              "children": [
                {
                  "type": "icon",
                  "icon": "chevron_right",
                  "size": 16,
                  "color": "$color.muted-foreground"
                },
                {
                  "type": "text",
                  "text": "Quit shortcut behavior",
                  "style": "caption"
                }
              ]
            },
            {
              "type": "row",
              "id": "section-confirmations-toggle-open",
              "align": "center",
              "gap": 8,
              "when": "fold_confirmations == true",
              "onTap": {
                "op": "setState",
                "id": "fold_confirmations",
                "value": false
              },
              "children": [
                {
                  "type": "icon",
                  "icon": "expand_more",
                  "size": 16,
                  "color": "$color.muted-foreground"
                },
                {
                  "type": "text",
                  "text": "Quit shortcut behavior",
                  "style": "caption"
                }
              ]
            },
            {
              "type": "container",
              "id": "section-confirmations-body",
              "direction": "column",
              "gap": 8,
              "when": "fold_confirmations == true",
              "children": [
                {
                  "type": "container",
                  "direction": "column",
                  "gap": 8,
                  "children": [
                    {
                      "type": "dropdown",
                      "id": "confirmQuit",
                      "hint": "Hold mode also quits on two quick presses",
                      "value": "direct",
                      "items": [
                        {
                          "label": "Direct",
                          "value": "direct"
                        },
                        {
                          "label": "Hold",
                          "value": "hold"
                        },
                        {
                          "label": "Double press",
                          "value": "double-click"
                        }
                      ],
                      "action": {
                        "client": [
                          {
                            "op": "toast",
                            "text": "Preview only — not saved in this build"
                          }
                        ]
                      },
                      "demo": true
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "button",
          "label": "Save",
          "action": {
            "path": "/ui/action/save-thread-behavior",
            "method": "POST",
            "name": "save-thread-behavior",
            "include": [
              "autoSettleDefault",
              "inactivityDays"
            ]
          }
        }
      ]
    }
  }
}
