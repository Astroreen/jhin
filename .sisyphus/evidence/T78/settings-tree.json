{
  "type": "screen",
  "title": "Settings",
  "body": {
    "type": "container",
    "direction": "column",
    "gap": 12,
    "padding": 16,
    "children": [
      {
        "type": "text",
        "text": "Settings",
        "style": "h2"
      },
      {
        "type": "card",
        "title": "Appearance",
        "children": [
          {
            "type": "segmented",
            "id": "appearance",
            "segments": [
              {
                "label": "System",
                "value": "system"
              },
              {
                "label": "Light",
                "value": "light"
              },
              {
                "label": "Dark",
                "value": "dark"
              }
            ],
            "value": "dark"
          },
          {
            "type": "input",
            "id": "canvas",
            "label": "Canvas",
            "value": "#101018",
            "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "errorText": "Use #RRGGBB or #AARRGGBB"
          },
          {
            "type": "input",
            "id": "accent",
            "label": "Accent",
            "value": "#ff0000",
            "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "errorText": "Use #RRGGBB or #AARRGGBB"
          },
          {
            "type": "segmented",
            "id": "density",
            "segments": [
              {
                "label": "Compact",
                "value": "compact"
              },
              {
                "label": "Comfortable",
                "value": "comfortable"
              },
              {
                "label": "Spacious",
                "value": "spacious"
              }
            ],
            "value": "compact"
          },
          {
            "type": "slider",
            "id": "panelMotionMs",
            "min": 0.0,
            "max": 400.0,
            "label": "Panel animations",
            "step": 20.0,
            "value": 200.0
          },
          {
            "type": "button",
            "label": "Save",
            "action": {
              "path": "/ui/action/save-appearance",
              "method": "POST",
              "name": "save-appearance",
              "include": [
                "appearance",
                "canvas",
                "accent",
                "density",
                "panelMotionMs"
              ]
            }
          }
        ]
      },
      {
        "type": "card",
        "title": "Thread behavior",
        "children": [
          {
            "type": "switch",
            "id": "autoSettleDefault",
            "label": "Auto-settle idle threads",
            "value": false
          },
          {
            "type": "slider",
            "id": "inactivityDays",
            "min": 1.0,
            "max": 30.0,
            "label": "Settle after inactivity (days)",
            "step": 1.0,
            "value": 14.0
          },
          {
            "type": "switch",
            "id": "settleOnPrMerged",
            "label": "Settle on PR merged",
            "value": false,
            "enabled": false,
            "tooltip": "PR linking is not enabled"
          },
          {
            "type": "button",
            "label": "Save",
            "action": {
              "path": "/ui/action/save-thread-behavior",
              "method": "POST",
              "name": "save-thread-behavior",
              "include": [
                "autoSettleDefault",
                "inactivityDays"
              ]
            }
          }
        ]
      },
      {
        "type": "card",
        "title": "Keyboard",
        "children": [
          {
            "type": "container",
            "direction": "column",
            "gap": 8,
            "children": [
              {
                "type": "list_row",
                "title": "composer.send",
                "subtitle": "mod+enter",
                "trailing": {
                  "type": "row",
                  "children": [
                    {
                      "type": "button",
                      "label": "Edit",
                      "style": "secondary",
                      "action": {
                        "path": "/ui/action/keybind-edit",
                        "method": "POST",
                        "name": "keybind-edit",
                        "payload": {
                          "command": "composer.send"
                        }
                      }
                    },
                    {
                      "type": "button",
                      "label": "Reset",
                      "style": "text",
                      "action": {
                        "path": "/ui/action/keybind-reset",
                        "method": "POST",
                        "name": "keybind-reset",
                        "payload": {
                          "command": "composer.send"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "type": "list_row",
                "title": "composer.sendAndNew",
                "subtitle": "ctrl+alt+enter",
                "trailing": {
                  "type": "row",
                  "children": [
                    {
                      "type": "button",
                      "label": "Edit",
                      "style": "secondary",
                      "action": {
                        "path": "/ui/action/keybind-edit",
                        "method": "POST",
                        "name": "keybind-edit",
                        "payload": {
                          "command": "composer.sendAndNew"
                        }
                      }
                    },
                    {
                      "type": "button",
                      "label": "Reset",
                      "style": "text",
                      "action": {
                        "path": "/ui/action/keybind-reset",
                        "method": "POST",
                        "name": "keybind-reset",
                        "payload": {
                          "command": "composer.sendAndNew"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "type": "list_row",
                "title": "composer.newline",
                "subtitle": "shift+enter",
                "trailing": {
                  "type": "row",
                  "children": [
                    {
                      "type": "button",
                      "label": "Edit",
                      "style": "secondary",
                      "action": {
                        "path": "/ui/action/keybind-edit",
                        "method": "POST",
                        "name": "keybind-edit",
                        "payload": {
                          "command": "composer.newline"
                        }
                      }
                    },
                    {
                      "type": "button",
                      "label": "Reset",
                      "style": "text",
                      "action": {
                        "path": "/ui/action/keybind-reset",
                        "method": "POST",
                        "name": "keybind-reset",
                        "payload": {
                          "command": "composer.newline"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "type": "list_row",
                "title": "composer.recallPrev",
                "subtitle": "mod+up",
                "trailing": {
                  "type": "row",
                  "children": [
                    {
                      "type": "button",
                      "label": "Edit",
                      "style": "secondary",
                      "action": {
                        "path": "/ui/action/keybind-edit",
                        "method": "POST",
                        "name": "keybind-edit",
                        "payload": {
                          "command": "composer.recallPrev"
                        }
                      }
                    },
                    {
                      "type": "button",
                      "label": "Reset",
                      "style": "text",
                      "action": {
                        "path": "/ui/action/keybind-reset",
                        "method": "POST",
                        "name": "keybind-reset",
                        "payload": {
                          "command": "composer.recallPrev"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "type": "list_row",
                "title": "composer.recallNext",
                "subtitle": "mod+down",
                "trailing": {
                  "type": "row",
                  "children": [
                    {
                      "type": "button",
