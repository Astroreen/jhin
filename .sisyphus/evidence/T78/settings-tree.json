                  "children": [
                    {
                      "type": "button",
                      "label": "Edit",
                      "style": "secondary",
                      "action": {
                        "path": "/ui/action/keybind-edit",
                        "method": "POST",
                        "name": "keybind-edit",
                        "payload": {
                          "command": "nav.forward"
                        }
                      }
                    },
                    {
                      "type": "button",
                      "label": "Reset",
                      "style": "text",
                      "action": {
                        "path": "/ui/action/keybind-reset",
                        "method": "POST",
                        "name": "keybind-reset",
                        "payload": {
                          "command": "nav.forward"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "type": "list_row",
                "title": "thread.new",
                "subtitle": "mod+n",
                "trailing": {
                  "type": "row",
                  "children": [
                    {
                      "type": "button",
                      "label": "Edit",
                      "style": "secondary",
                      "action": {
                        "path": "/ui/action/keybind-edit",
                        "method": "POST",
                        "name": "keybind-edit",
                        "payload": {
                          "command": "thread.new"
                        }
                      }
                    },
                    {
                      "type": "button",
                      "label": "Reset",
                      "style": "text",
                      "action": {
                        "path": "/ui/action/keybind-reset",
                        "method": "POST",
                        "name": "keybind-reset",
                        "payload": {
                          "command": "thread.new"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "type": "button",
                "label": "Restore defaults",
                "style": "secondary",
                "action": {
                  "path": "/ui/action/keybind-restore",
                  "method": "POST",
                  "name": "keybind-restore"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "button",
        "label": "Change server",
        "style": "secondary",
        "action": {
          "op": "openProfiles"
        }
      },
      {
        "type": "button",
        "label": "Sign out",
        "style": "danger"
      },
      {
        "type": "button",
        "label": "Help",
        "style": "text"
      }
    ]
  }
}
