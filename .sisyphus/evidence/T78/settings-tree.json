                      "style": "secondary",
                      "action": {
                        "path": "/ui/action/keybind-edit",
                        "method": "POST",
                        "name": "keybind-edit",
                        "payload": {
                          "command": "composer.recallNext"
                        }
                      }
                    },
                    {
                      "type": "button",
                      "label": "Reset",
                      "style": "text",
                      "action": {
                        "path": "/ui/action/keybind-reset",
                        "method": "POST",
                        "name": "keybind-reset",
                        "payload": {
                          "command": "composer.recallNext"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "type": "list_row",
                "title": "palette.open",
                "subtitle": "ctrl+k",
                "trailing": {
                  "type": "row",
                  "children": [
                    {
                      "type": "button",
                      "label": "Edit",
                      "style": "secondary",
                      "action": {
                        "path": "/ui/action/keybind-edit",
                        "method": "POST",
                        "name": "keybind-edit",
                        "payload": {
                          "command": "palette.open"
                        }
                      }
                    },
                    {
                      "type": "button",
                      "label": "Reset",
                      "style": "text",
                      "action": {
                        "path": "/ui/action/keybind-reset",
                        "method": "POST",
                        "name": "keybind-reset",
                        "payload": {
                          "command": "palette.open"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "type": "list_row",
                "title": "thread.undo",
                "subtitle": "ctrl+z",
                "trailing": {
                  "type": "row",
                  "children": [
                    {
                      "type": "button",
                      "label": "Edit",
                      "style": "secondary",
                      "action": {
                        "path": "/ui/action/keybind-edit",
                        "method": "POST",
                        "name": "keybind-edit",
                        "payload": {
                          "command": "thread.undo"
                        }
                      }
                    },
                    {
                      "type": "button",
                      "label": "Reset",
                      "style": "text",
                      "action": {
                        "path": "/ui/action/keybind-reset",
                        "method": "POST",
                        "name": "keybind-reset",
                        "payload": {
                          "command": "thread.undo"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "type": "list_row",
                "title": "nav.back",
                "subtitle": "alt+left",
                "trailing": {
                  "type": "row",
                  "children": [
                    {
                      "type": "button",
                      "label": "Edit",
                      "style": "secondary",
                      "action": {
                        "path": "/ui/action/keybind-edit",
                        "method": "POST",
                        "name": "keybind-edit",
