                  "type": "segmented",
                  "value": "compact"
                },
                {
                  "id": "panelMotionMs",
                  "label": "Panel animations",
                  "max": 400.0,
                  "min": 0.0,
                  "step": 20.0,
                  "type": "slider",
                  "value": 200.0
                },
                {
                  "action": {
                    "include": [
                      "appearance",
                      "canvas",
                      "accent",
                      "density",
                      "panelMotionMs"
                    ],
                    "method": "POST",
                    "name": "save-appearance",
                    "path": "/ui/action/save-appearance"
