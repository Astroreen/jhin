{
  "api": 2,
  "contract": {
    "api": 2,
    "minApi": 2,
    "minSchema": 3,
    "schema": 3
  },
  "density": "compact",
  "empty": false,
  "entry": "sessions",
  "fallbacks": {
    "error": {
      "children": [
        {
          "style": "body",
          "text": "The server could not render this screen.",
          "type": "text"
        },
        {
          "action": {
            "op": "reloadBootstrap"
          },
          "label": "Retry",
          "style": "primary",
          "type": "button"
        },
        {
          "action": {
            "op": "openProfiles"
          },
          "label": "Change server",
          "style": "text",
          "type": "button"
        }
      ],
      "title": "Something went wrong",
      "type": "card"
    },
    "offline": {
      "children": [
        {
          "style": "body",
          "text": "The server is unreachable. Your screens are shown from the cache.",
          "type": "text"
        },
        {
          "action": {
            "op": "refresh"
          },
          "label": "Retry",
          "style": "primary",
          "type": "button"
        }
      ],
      "title": "Offline",
      "type": "card"
    }
  },
  "keymap": [
    {
      "command": "composer.send",
      "key": "mod+enter",
      "when": "composerFocus"
    },
    {
      "command": "composer.sendAndNew",
      "key": "ctrl+alt+enter",
      "when": "composerFocus"
    },
    {
      "command": "composer.newline",
      "key": "shift+enter",
      "when": "composerFocus"
    },
    {
      "command": "composer.recallPrev",
      "key": "mod+up",
      "when": "composerFocus"
    },
    {
      "command": "composer.recallNext",
      "key": "mod+down",
      "when": "composerFocus"
    },
    {
      "command": "palette.open",
      "key": "ctrl+k"
    },
    {
      "command": "thread.undo",
      "key": "ctrl+z"
    },
    {
      "command": "nav.back",
      "key": "alt+left"
    },
    {
      "command": "nav.forward",
      "key": "alt+right"
    },
    {
      "command": "thread.new",
      "key": "mod+n"
    }
  ],
  "screenEndpoint": "/ui/screen/{id}",
  "screens": [
    {
      "id": "sessions",
      "node": {
        "body": {
          "body": {
            "children": [
              {
                "style": "caption",
                "text": "Choose a thread from the sidebar to open the conversation.",
                "type": "text"
              }
            ],
            "title": "Select a thread",
            "type": "card"
          },
          "header": {
            "align": "center",
            "children": [
              {
                "activeIndex": 0,
                "items": [
                  {
                    "label": "Sessions",
                    "screen": "sessions"
                  },
                  {
                    "label": "Settings",
                    "screen": "settings"
                  },
                  {
                    "label": "Plugins",
                    "screen": "plugins"
                  }
                ],
                "kind": "tabs",
                "type": "nav"
              },
              {
                "type": "spacer"
              },
              {
                "action": {
                  "method": "POST",
                  "name": "arrange-toggle",
                  "path": "/ui/action/arrange-toggle",
                  "payload": {
                    "arrange": true
                  }
                },
                "label": "Arrange threads",
                "style": "secondary",
                "type": "button"
              }
            ],
            "type": "row"
          },
          "id": "sessions-shell",
          "sidebar": {
            "empty": {
              "style": "caption",
              "text": "No threads yet.",
              "type": "text"
            },
            "sections": [
              {
                "collapsed": false,
                "collapsible": false,
                "id": "section-pinned",
                "items": [],
                "label": "Pinned"
              },
              {
                "collapsed": false,
                "collapsible": false,
                "id": "section-active",
                "items": [],
                "label": "Active"
              },
              {
                "collapsed": false,
                "collapsible": false,
                "id": "section-snoozed",
                "items": [],
                "label": "Snoozed"
              },
              {
                "collapsed": true,
                "collapsible": true,
                "id": "section-settled",
                "items": [],
                "label": "Settled"
              }
            ],
            "type": "list"
          },
          "type": "shell"
        },
        "title": "Sessions",
        "type": "screen"
      }
    },
    {
      "id": "settings",
