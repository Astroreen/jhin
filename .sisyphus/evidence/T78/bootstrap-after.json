                    {
                      "label": "System",
                      "value": "system"
                    },
                    {
                      "label": "Light",
                      "value": "light"
                    },
                    {
                      "label": "Dark",
                      "value": "dark"
                    }
                  ],
                  "type": "segmented",
                  "value": "dark"
                },
                {
                  "errorText": "Use #RRGGBB or #AARRGGBB",
                  "id": "canvas",
                  "label": "Canvas",
                  "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
                  "type": "input",
                  "value": "#101018"
                },
                {
                  "errorText": "Use #RRGGBB or #AARRGGBB",
                  "id": "accent",
                  "label": "Accent",
                  "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
                  "type": "input",
                  "value": "#ff0000"
                },
                {
                  "id": "density",
