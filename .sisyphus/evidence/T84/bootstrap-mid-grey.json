  "title": "Jhin",
  "tokens": {
    "color": {
      "accent": "var(--accent)",
      "accent-foreground": "var(--contrast-accent-foreground)",
      "background": "var(--background)",
      "border": "var(--contrast-border)",
      "card": "var(--card)",
      "card-foreground": "var(--contrast-card-foreground)",
      "code": "var(--code-background)",
      "code-foreground": "var(--code-foreground)",
      "contrast": {
        "accent-foreground": "color-mix(in oklab, color-mix(in oklab, var(--accent-foreground) var(--appearance-contrast-base), var(--accent)), var(--appearance-contrast-target) var(--appearance-contrast-boost))",
        "border": "color-mix(in srgb, color-mix(in srgb, var(--border) var(--appearance-contrast-base), transparent), var(--foreground) var(--appearance-contrast-border-boost))",
        "card-foreground": "color-mix(in oklab, color-mix(in oklab, var(--card-foreground) var(--appearance-contrast-base), var(--card)), var(--appearance-contrast-target) var(--appearance-contrast-boost))",
        "foreground": "color-mix(in oklab, color-mix(in oklab, var(--foreground) var(--appearance-contrast-base), var(--background)), var(--appearance-contrast-target) var(--appearance-contrast-boost))",
