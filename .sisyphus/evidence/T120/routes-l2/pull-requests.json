{
  "type": "screen",
  "title": "Pull Requests",
  "body": {
    "type": "shell",
    "id": "pull-requests-shell",
    "breakpoint": 768,
    "topbar": {
      "type": "row",
      "id": "pull-requests-topbar",
      "align": "center",
      "children": [
        {
          "type": "text",
          "text": "Jhin",
          "style": "h3",
          "bold": true
        },
        {
          "type": "text",
          "text": "Pull Requests",
          "style": "body",
          "bold": true
        },
        {
          "type": "spacer"
        },
        {
          "type": "nav",
          "kind": "tabs",
          "items": [
            {
              "label": "Sessions",
              "screen": "sessions"
            },
            {
              "label": "Settings",
              "screen": "settings"
            },
            {
              "label": "Plugins",
              "screen": "plugins"
            }
          ]
        }
      ]
    },
    "topbarCompact": {
      "type": "row",
      "id": "pull-requests-topbar-compact",
      "align": "center",
      "children": [
        {
          "type": "text",
          "text": "Jhin",
          "style": "h3",
          "bold": true
        },
        {
          "type": "text",
          "text": "Pull Requests",
          "style": "body"
        },
        {
          "type": "spacer"
        }
      ]
    },
    "pageHeader": {
      "type": "row",
      "id": "pull-requests-page-header",
      "align": "center",
      "gap": 8,
      "children": [
        {
          "type": "text",
          "text": "Pull Requests",
          "style": "h3"
        },
        {
          "type": "spacer"
        },
        {
          "type": "segmented",
          "id": "pullRequestState",
          "segments": [
            {
              "label": "Open",
              "value": "open"
            },
            {
              "label": "Closed",
              "value": "closed"
            },
            {
              "label": "All",
              "value": "all"
            }
          ],
          "value": "open",
          "demo": true
        },
        {
          "type": "icon_button",
          "id": "pullRequestsRefresh",
          "icon": "refresh",
          "tooltip": "Refresh pull requests",
          "demo": true,
          "action": {
            "client": [
              {
                "op": "toast",
                "text": "Preview only — pull requests are not refreshed in this build"
              }
            ]
          }
        }
      ]
    },
    "body": {
      "type": "container",
      "id": "pull-requests-body",
      "direction": "column",
      "gap": 16,
      "padding": 16,
      "children": [
        {
          "type": "card",
          "title": "Pull Requests",
          "children": [
            {
              "type": "list",
              "id": "pull-requests-list",
              "items": [
                {
                  "type": "list_row",
                  "id": "pull-request-482",
                  "leading": {
                    "type": "icon",
                    "icon": "call_merge",
                    "size": 20,
                    "color": "$color.success"
                  },
                  "title": "#482 Add usage meter to the settings panel",
                  "subtitle": {
                    "type": "row",
                    "align": "center",
                    "gap": 6,
                    "children": [
                      {
                        "type": "chip",
                        "label": "feat/usage-meter",
                        "icon": "account_tree"
                      },
                      {
                        "type": "text",
                        "text": "→ main",
                        "style": "mono"
                      },
                      {
                        "type": "text",
                        "text": "octocat",
                        "style": "caption"
                      }
                    ]
                  },
                  "trailing": {
                    "type": "row",
                    "align": "center",
                    "gap": 6,
                    "children": [
                      {
                        "type": "badge",
                        "label": "Open"
                      },
                      {
                        "type": "chip",
                        "label": "Approved"
                      }
                    ]
                  },
                  "demo": true,
                  "action": {
                    "client": [
                      {
                        "op": "toast",
                        "text": "Preview only — pull request #482 is not opened in this build"
                      }
                    ]
                  }
                },
                {
                  "type": "list_row",
                  "id": "pull-request-479",
                  "leading": {
                    "type": "icon",
                    "icon": "edit_note",
                    "size": 20,
                    "color": "$color.muted-foreground"
                  },
                  "title": "#479 Draft: pull request detail shell",
                  "subtitle": {
                    "type": "row",
                    "align": "center",
                    "gap": 6,
                    "children": [
                      {
                        "type": "chip",
                        "label": "feat/pr-detail",
                        "icon": "account_tree"
                      },
                      {
                        "type": "text",
                        "text": "→ main",
                        "style": "mono"
                      },
                      {
                        "type": "text",
                        "text": "monalisa",
                        "style": "caption"
                      }
                    ]
                  },
                  "trailing": {
                    "type": "row",
                    "align": "center",
                    "gap": 6,
                    "children": [
                      {
                        "type": "badge",
                        "label": "Draft"
                      },
                      {
                        "type": "chip",
                        "label": "Awaiting review"
                      }
                    ]
                  },
                  "demo": true,
                  "action": {
                    "client": [
                      {
                        "op": "toast",
                        "text": "Preview only — pull request #479 is not opened in this build"
                      }
                    ]
                  }
                },
                {
                  "type": "list_row",
                  "id": "pull-request-471",
                  "leading": {
                    "type": "icon",
                    "icon": "merge",
                    "size": 20,
                    "color": "$color.primary"
                  },
                  "title": "#471 Cache the bootstrap payload",
                  "subtitle": {
                    "type": "row",
                    "align": "center",
                    "gap": 6,
                    "children": [
                      {
                        "type": "chip",
                        "label": "perf/bootstrap-cache",
                        "icon": "account_tree"
                      },
                      {
                        "type": "text",
                        "text": "→ main",
                        "style": "mono"
                      },
                      {
                        "type": "text",
                        "text": "hubot",
                        "style": "caption"
                      }
                    ]
                  },
                  "trailing": {
                    "type": "row",
                    "align": "center",
                    "gap": 6,
                    "children": [
                      {
                        "type": "badge",
                        "label": "Merged"
                      },
                      {
                        "type": "chip",
                        "label": "Approved"
                      }
                    ]
                  },
                  "demo": true,
                  "action": {
                    "client": [
                      {
                        "op": "toast",
                        "text": "Preview only — pull request #471 is not opened in this build"
                      }
                    ]
                  }
                },
                {
                  "type": "list_row",
                  "id": "pull-request-468",
                  "leading": {
                    "type": "icon",
                    "icon": "cancel",
                    "size": 20,
                    "color": "$color.destructive"
                  },
                  "title": "#468 Drop the legacy v1 backend",
                  "subtitle": {
                    "type": "row",
                    "align": "center",
                    "gap": 6,
                    "children": [
                      {
                        "type": "chip",
                        "label": "chore/drop-v1",
                        "icon": "account_tree"
                      },
                      {
                        "type": "text",
                        "text": "→ main",
                        "style": "mono"
                      },
                      {
                        "type": "text",
                        "text": "octocat",
                        "style": "caption"
                      }
                    ]
                  },
                  "trailing": {
                    "type": "row",
                    "align": "center",
                    "gap": 6,
                    "children": [
                      {
                        "type": "badge",
                        "label": "Closed"
                      },
                      {
                        "type": "chip",
                        "label": "Changes requested"
                      }
                    ]
                  },
                  "demo": true,
                  "action": {
                    "client": [
                      {
                        "op": "toast",
                        "text": "Preview only — pull request #468 is not opened in this build"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "card",
          "id": "pull-request-detail",
          "title": "Pull request detail",
          "children": [
            {
              "type": "column",
              "id": "pull-request-summary-header",
              "gap": 6,
              "children": [
                {
                  "type": "row",
                  "align": "center",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "text": "#482 Add usage meter to the settings panel",
                      "style": "h3"
                    },
                    {
                      "type": "badge",
                      "label": "Open"
                    },
                    {
                      "type": "spacer"
                    },
                    {
                      "type": "text",
                      "text": "+128 −34",
                      "style": "mono"
                    }
                  ]
                },
                {
                  "type": "row",
                  "align": "center",
                  "gap": 6,
                  "children": [
                    {
                      "type": "chip",
                      "label": "feat/usage-meter",
                      "icon": "account_tree"
                    },
                    {
                      "type": "text",
                      "text": "→ main",
                      "style": "mono"
                    },
                    {
                      "type": "text",
                      "text": "octocat · 2 hours ago",
                      "style": "caption"
                    }
                  ]
                }
              ]
            },
            {
              "type": "tabs",
              "id": "pull-request-detail-tabs",
              "activeIndex": 0,
              "demo": true,
              "items": [
                {
                  "label": "Summary",
                  "icon": "description",
                  "panel": {
                    "type": "column",
                    "id": "pull-request-summary-panel",
                    "gap": 8,
                    "padding": 8,
                    "children": [
                      {
                        "type": "text",
                        "text": "Adds a token meter to the usage page and wires the per-provider series into the shared chart primitive.",
                        "style": "body"
                      },
                      {
                        "type": "text",
                        "text": "5 changed files",
                        "style": "caption"
                      }
                    ]
                  }
                },
                {
                  "label": "Timeline",
                  "icon": "history",
                  "panel": {
                    "type": "container",
                    "direction": "column",
                    "gap": 6,
                    "padding": 8,
                    "children": [
                      {
                        "type": "row",
                        "id": "pull-request-review-hubot",
                        "align": "center",
                        "gap": 8,
                        "children": [
                          {
                            "type": "avatar",
                            "initials": "H",
                            "size": 20,
                            "shape": "circle"
                          },
                          {
                            "type": "text",
                            "text": "hubot",
                            "style": "small"
                          },
                          {
                            "type": "spacer"
                          },
                          {
                            "type": "chip",
                            "label": "Approved"
                          },
                          {
                            "type": "text",
                            "text": "1 hour ago",
                            "style": "caption"
                          }
                        ]
                      },
                      {
                        "type": "row",
                        "id": "pull-request-review-monalisa",
                        "align": "center",
                        "gap": 8,
                        "children": [
                          {
                            "type": "avatar",
                            "initials": "M",
                            "size": 20,
                            "shape": "circle"
                          },
                          {
                            "type": "text",
                            "text": "monalisa",
                            "style": "small"
                          },
                          {
                            "type": "spacer"
                          },
                          {
                            "type": "chip",
                            "label": "Awaiting review"
                          },
                          {
                            "type": "text",
                            "text": "3 hours ago",
                            "style": "caption"
                          }
                        ]
                      }
                    ]
                  }
                },
                {
                  "label": "Code",
                  "icon": "difference",
                  "panel": {
                    "type": "code_block",
                    "id": "pull-request-diff",
                    "language": "diff",
                    "demo": true,
                    "code": "feat/usage-meter.patch\n@@ -1,4 +1,6 @@\n@@ -10,3 +12,4 @@"
                  }
                }
              ]
            },
            {
              "type": "row",
              "align": "center",
              "gap": 8,
              "children": [
                {
                  "type": "menu",
                  "id": "pull-request-link-menu",
                  "demo": true,
                  "trigger": {
                    "type": "button",
                    "label": "Link to thread",
                    "style": "secondary",
                    "icon": "link",
                    "demo": true
                  },
                  "items": [
                    {
                      "label": "Link to this thread",
                      "icon": "link",
                      "action": {
                        "client": [
                          {
                            "op": "toast",
                            "text": "Preview only — pull requests are not linked to threads in this build"
                          }
                        ]
                      }
                    },
                    {
                      "label": "Unlink from this thread",
                      "icon": "link_off",
                      "danger": true,
                      "action": {
                        "client": [
                          {
                            "op": "toast",
                            "text": "Preview only — pull requests are not unlinked in this build"
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "type": "button",
                  "label": "Unlink",
                  "style": "danger",
                  "icon": "link_off",
                  "demo": true,
                  "action": {
                    "client": [
                      {
                        "op": "toast",
                        "text": "Preview only — pull requests are not unlinked in this build"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
