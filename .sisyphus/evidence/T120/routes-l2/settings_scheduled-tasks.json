{
  "type": "screen",
  "title": "Settings",
  "body": {
    "type": "shell",
    "id": "settings-shell",
    "breakpoint": 768,
    "topbar": {
      "type": "row",
      "id": "settings-topbar",
      "align": "center",
      "children": [
        {
          "type": "text",
          "text": "Jhin",
          "style": "h3",
          "bold": true
        },
        {
          "type": "spacer"
        },
        {
          "type": "button",
          "label": "Back to threads",
          "style": "secondary",
          "action": {
            "op": "navigate",
            "screen": "sessions"
          }
        }
      ]
    },
    "topbarCompact": {
      "type": "row",
      "id": "settings-topbar-compact",
      "align": "center",
      "children": [
        {
          "type": "text",
          "text": "Jhin",
          "style": "h3",
          "bold": true
        },
        {
          "type": "spacer"
        }
      ]
    },
    "pageHeader": {
      "type": "row",
      "id": "settings-breadcrumb",
      "align": "center",
      "gap": 8,
      "children": [
        {
          "type": "text",
          "text": "Settings",
          "style": "small"
        },
        {
          "type": "text",
          "text": "/",
          "style": "small"
        },
        {
          "type": "text",
          "text": "Scheduled Tasks",
          "style": "body",
          "bold": true
        }
      ]
    },
    "sidebar": {
      "type": "nav",
      "id": "settings-nav",
      "kind": "sidebar",
      "items": [
        {
          "id": "settings:general",
          "label": "General",
          "icon": "settings",
          "screen": "settings:general"
        },
        {
          "id": "settings:appearance",
          "label": "Appearance",
          "icon": "palette",
          "screen": "settings:appearance"
        },
        {
          "id": "settings:keybindings",
          "label": "Keybindings",
          "icon": "keyboard",
          "screen": "settings:keybindings"
        },
        {
          "id": "settings:providers",
          "label": "Providers",
          "icon": "smart_toy",
          "screen": "settings:providers"
        },
        {
          "id": "settings:connections",
          "label": "Connections",
          "icon": "link",
          "screen": "settings:connections"
        },
        {
          "id": "settings:integrations",
          "label": "Integrations",
          "icon": "extension",
          "screen": "settings:integrations"
        },
        {
          "id": "settings:diagnostics",
          "label": "Diagnostics",
          "icon": "monitor_heart",
          "screen": "settings:diagnostics"
        },
        {
          "id": "settings:storage",
          "label": "Storage",
          "icon": "storage",
          "screen": "settings:storage"
        },
        {
          "id": "settings:archived",
          "label": "Archive",
          "icon": "archive",
          "screen": "settings:archived"
        },
        {
          "id": "settings:projects",
          "label": "Project",
          "icon": "folder",
          "screen": "settings:projects"
        },
        {
          "id": "settings:scheduled-tasks",
          "label": "Scheduled Tasks",
          "icon": "schedule",
          "screen": "settings:scheduled-tasks"
        },
        {
          "id": "settings:source-control",
          "label": "Source Control",
          "icon": "account_tree",
          "screen": "settings:source-control"
        },
        {
          "id": "settings:snap-shot",
          "label": "SnapShots",
          "icon": "photo_camera",
          "screen": "settings:snap-shot"
        },
        {
          "id": "settings:licenses",
          "label": "Open source licenses",
          "icon": "description",
          "screen": "settings:licenses"
        }
      ],
      "activeId": "settings:scheduled-tasks"
    },
    "stageBackdrop": true,
    "body": {
      "type": "container",
      "direction": "column",
      "gap": 12,
      "padding": 16,
      "children": [
        {
          "type": "card",
          "title": "Scheduled tasks",
          "children": [
            {
              "type": "container",
              "direction": "column",
              "gap": 8,
              "children": [
                {
                  "type": "list_row",
                  "id": "scheduled-task-task-sentry",
                  "title": "Check for Sentry issues",
                  "subtitle": {
                    "type": "column",
                    "gap": 2,
                    "children": [
                      {
                        "type": "text",
                        "text": "Review new Sentry issues and open a thread for each regression.",
                        "style": "caption",
                        "maxLines": 2,
                        "ellipsis": true
                      },
                      {
                        "type": "text",
                        "text": "Every 15 min · in 12m",
                        "style": "caption"
                      }
                    ]
                  },
                  "trailing": {
                    "type": "row",
                    "align": "center",
                    "gap": 8,
                    "children": [
                      {
                        "type": "badge",
                        "label": "succeeded"
                      },
                      {
                        "type": "switch",
                        "id": "taskEnabled-task-sentry",
                        "label": "Enabled",
                        "value": true,
                        "demo": true
                      }
                    ]
                  },
                  "demo": true
                },
                {
                  "type": "list_row",
                  "id": "scheduled-task-task-deps",
                  "title": "Weekly dependency bump",
                  "subtitle": {
                    "type": "column",
                    "gap": 2,
                    "children": [
                      {
                        "type": "text",
                        "text": "Update dependencies and open a pull request.",
                        "style": "caption",
                        "maxLines": 2,
                        "ellipsis": true
                      },
                      {
                        "type": "text",
                        "text": "Weekdays at 09:00 · in 2h",
                        "style": "caption"
                      }
                    ]
                  },
                  "trailing": {
                    "type": "row",
                    "align": "center",
                    "gap": 8,
                    "children": [
                      {
                        "type": "switch",
                        "id": "taskEnabled-task-deps",
                        "label": "Enabled",
                        "value": true,
                        "demo": true
                      }
                    ]
                  },
                  "demo": true
                },
                {
                  "type": "list_row",
                  "id": "scheduled-task-task-digest",
                  "title": "Nightly digest",
                  "subtitle": {
                    "type": "column",
                    "gap": 2,
                    "children": [
                      {
                        "type": "text",
                        "text": "Summarize the day's merged pull requests.",
                        "style": "caption",
                        "maxLines": 2,
                        "ellipsis": true
                      },
                      {
                        "type": "text",
                        "text": "Daily at 22:00 · Not scheduled",
                        "style": "caption"
                      }
                    ]
                  },
                  "trailing": {
                    "type": "row",
                    "align": "center",
                    "gap": 8,
                    "children": [
                      {
                        "type": "badge",
                        "label": "failed"
                      },
                      {
                        "type": "switch",
                        "id": "taskEnabled-task-digest",
                        "label": "Enabled",
                        "value": false,
                        "demo": true
                      }
                    ]
                  },
                  "demo": true
                }
              ]
            },
            {
              "type": "button",
              "label": "New task",
              "id": "newScheduledTask",
              "style": "secondary",
              "icon": "add",
              "demo": true,
              "action": {
                "client": [
                  {
                    "op": "toast",
                    "text": "Preview only — scheduled tasks are not created in this build"
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
