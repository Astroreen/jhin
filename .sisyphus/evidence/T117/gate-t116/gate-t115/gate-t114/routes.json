          {
            "type": "text",
            "text": "Jhin",
            "style": "h3"
          },
          {
            "type": "badge",
            "label": "Active"
          },
          {
            "type": "badge",
            "label": "Git"
          },
          {
            "type": "spacer"
          },
          {
            "type": "row",
            "id": "project-branch-toolbar",
            "align": "center",
            "gap": 8,
            "children": [
              {
                "type": "dropdown",
                "id": "projectBranch",
                "hint": "Branch",
                "items": [
                  {
                    "label": "main",
                    "value": "main"
                  },
                  {
                    "label": "main",
                    "value": "main"
                  }
                ],
                "value": "main",
                "demo": true,
                "action": {
                  "client": [
                    {
                      "op": "toast",
                      "text": "Preview only — branches are not switched in this build"
                    }
                  ]
                }
              },
              {
                "type": "dropdown",
                "id": "projectWorktree",
                "hint": "Worktree",
                "items": [
                  {
                    "label": "default",
                    "value": "default"
                  },
                  {
                    "label": "default",
                    "value": "default"
                  }
                ],
                "value": "default",
                "demo": true,
                "action": {
                  "client": [
                    {
                      "op": "toast",
                      "text": "Preview only — worktrees are not created in this build"
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "body": {
        "type": "container",
        "id": "project-body",
        "direction": "column",
        "gap": 16,
        "padding": 16,
        "children": [
          {
            "type": "card",
            "id": "project-header",
            "title": "Project",
            "children": [
              {
                "type": "row",
                "align": "center",
                "gap": 12,
                "children": [
                  {
                    "type": "avatar",
                    "initials": "JH",
                    "size": 40,
                    "shape": "square"
                  },
                  {
                    "type": "column",
                    "gap": 2,
                    "children": [
                      {
                        "type": "text",
