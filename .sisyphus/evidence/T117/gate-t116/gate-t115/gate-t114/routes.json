                        "client": [
                          {
                            "op": "toast",
                            "text": "Preview only — scripts are not run in this build"
                          }
                        ]
                      }
                    },
                    "demo": true
                  },
                  {
                    "type": "list_row",
                    "id": "project-script-test",
                    "leading": {
                      "type": "icon",
                      "icon": "terminal",
                      "size": 20
                    },
                    "title": "Test",
                    "subtitle": "./gradlew test",
                    "trailing": {
                      "type": "button",
                      "label": "Run",
                      "style": "secondary",
                      "icon": "play_arrow",
                      "demo": true,
                      "action": {
                        "client": [
                          {
                            "op": "toast",
                            "text": "Preview only — scripts are not run in this build"
                          }
                        ]
                      }
                    },
                    "demo": true
                  },
                  {
                    "type": "list_row",
                    "id": "project-script-lint",
                    "leading": {
