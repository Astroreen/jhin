      "topbarCompact": {
        "type": "row",
        "id": "project-topbar-compact",
        "align": "center",
        "children": [
          {
            "type": "text",
            "text": "Jhin",
            "style": "h3",
            "bold": true
          },
          {
            "type": "text",
            "text": "Jhin",
            "style": "body"
          },
          {
            "type": "spacer"
          }
        ]
      },
      "pageHeader": {
        "type": "row",
        "id": "project-page-header",
        "align": "center",
        "gap": 8,
        "children": [
          {
            "type": "avatar",
            "initials": "JH",
            "size": 28,
            "shape": "square"
