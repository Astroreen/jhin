{
  "pair": {
    "type": "screen",
    "title": "Pair",
    "body": {
      "type": "container",
      "direction": "column",
      "gap": 12,
      "padding": 16,
      "children": [
        {
          "type": "text",
          "text": "Pair with this environment",
          "style": "h2"
        },
        {
          "type": "banner",
          "id": "enroll-error",
          "visible": false,
          "content": "Enrollment failed"
        },
        {
          "type": "card",
          "title": "Enroll this device",
          "children": [
            {
              "type": "form",
              "fields": [
                {
                  "type": "input",
                  "id": "code",
                  "label": "Enrollment code",
                  "required": true,
                  "errorText": "Enrollment code is required"
                },
                {
                  "type": "input",
                  "id": "deviceName",
                  "label": "Device name",
                  "required": true,
                  "errorText": "Device name is required"
                }
              ],
              "submit": {
                "label": "Enroll",
                "action": {
                  "path": "/ui/action/enroll",
                  "method": "POST",
                  "name": "enroll",
                  "include": [
                    "code",
                    "deviceName"
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "text",
          "text": "Ask your administrator for an enrollment code.",
          "style": "caption"
        }
      ]
    }
  },
  "welcome": {
    "type": "screen",
    "title": "Welcome",
    "body": {
      "type": "shell",
      "id": "welcome-shell",
      "breakpoint": 768,
      "topbar": {
        "type": "row",
        "id": "welcome-topbar",
        "align": "center",
        "children": [
          {
            "type": "text",
            "text": "Jhin",
            "style": "h3",
            "bold": true
          },
          {
            "type": "text",
            "text": "Welcome",
            "style": "body",
            "bold": true
          },
          {
            "type": "spacer"
          },
          {
            "type": "nav",
            "kind": "tabs",
            "items": [
              {
                "label": "Sessions",
                "screen": "sessions"
              },
              {
                "label": "Settings",
                "screen": "settings"
              },
              {
                "label": "Plugins",
                "screen": "plugins"
              }
            ]
          }
        ]
      },
      "topbarCompact": {
        "type": "row",
        "id": "welcome-topbar-compact",
        "align": "center",
        "children": [
          {
            "type": "text",
            "text": "Jhin",
            "style": "h3",
            "bold": true
          },
          {
            "type": "text",
            "text": "Welcome",
            "style": "body"
          },
          {
            "type": "spacer"
          }
        ]
      },
      "pageHeader": {
        "type": "row",
        "id": "welcome-page-header",
        "align": "center",
        "gap": 8,
        "children": [
          {
            "type": "text",
            "text": "Welcome",
            "style": "h3"
          },
          {
            "type": "spacer"
          },
          {
            "type": "text",
            "text": "Set up Jhin in three steps",
            "style": "caption"
          }
        ]
      },
      "body": {
        "type": "container",
        "id": "welcome-body",
        "direction": "column",
        "gap": 16,
        "padding": 16,
        "children": [
          {
            "type": "card",
            "id": "welcome-card",
            "title": "Set up Jhin",
            "children": [
              {
                "type": "segmented",
                "id": "welcomeStep",
                "segments": [
                  {
                    "label": "Theme",
                    "value": 0
                  },
                  {
                    "label": "Host",
                    "value": 1
                  },
                  {
                    "label": "Thread",
                    "value": 2
                  }
                ],
                "value": 0,
                "demo": true
              },
              {
                "type": "column",
                "id": "welcome-step-theme",
                "gap": 12,
                "when": "welcomeStep == 0",
                "children": [
                  {
                    "type": "text",
                    "text": "Pick a theme",
                    "style": "h3"
                  },
                  {
                    "type": "text",
                    "text": "Choose how Jhin looks. You can change this later in Settings.",
                    "style": "body"
                  },
                  {
                    "type": "segmented",
                    "id": "welcomeTheme",
                    "segments": [
                      {
                        "label": "T3 Chat",
                        "value": "t3-chat"
                      },
                      {
                        "label": "Midnight",
                        "value": "midnight"
                      },
                      {
                        "label": "Paper",
                        "value": "paper"
                      }
                    ],
                    "value": "t3-chat",
                    "demo": true,
                    "action": {
                      "client": [
                        {
                          "op": "toast",
                          "text": "Preview only — the theme is not applied in this build"
                        }
                      ]
                    }
                  },
                  {
                    "type": "row",
                    "align": "center",
                    "gap": 8,
                    "children": [
                      {
                        "type": "spacer"
                      },
                      {
                        "type": "button",
                        "label": "Next",
                        "id": "welcome-next",
                        "style": "primary",
                        "icon": "arrow_forward",
                        "demo": true,
                        "action": {
                          "client": [
                            {
                              "op": "setState",
                              "id": "welcomeStep",
                              "value": 1
                            }
                          ]
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "type": "column",
                "id": "welcome-step-host",
                "gap": 12,
                "when": "welcomeStep == 1",
                "children": [
                  {
                    "type": "text",
                    "text": "Connect a host",
                    "style": "h3"
                  },
                  {
                    "type": "text",
                    "text": "Point Jhin at a machine to run your agents. You can add more later.",
                    "style": "body"
                  },
                  {
                    "type": "input",
                    "id": "welcomeHostUrl",
                    "label": "Host URL",
                    "placeholder": "https://your-server:5230",
                    "demo": true
                  },
                  {
                    "type": "row",
                    "align": "center",
                    "gap": 8,
                    "children": [
                      {
                        "type": "button",
                        "label": "Back",
                        "id": "welcome-back",
                        "style": "secondary",
                        "icon": "arrow_back",
                        "demo": true,
                        "action": {
                          "client": [
                            {
                              "op": "setState",
                              "id": "welcomeStep",
                              "value": 0
                            }
                          ]
                        }
                      },
                      {
                        "type": "spacer"
                      },
                      {
                        "type": "button",
                        "label": "Next",
                        "id": "welcome-next",
                        "style": "primary",
                        "icon": "arrow_forward",
                        "demo": true,
                        "action": {
                          "client": [
                            {
                              "op": "setState",
                              "id": "welcomeStep",
                              "value": 2
                            }
                          ]
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "type": "column",
                "id": "welcome-step-thread",
                "gap": 12,
                "when": "welcomeStep == 2",
                "children": [
                  {
                    "type": "text",
                    "text": "Start a thread",
                    "style": "h3"
                  },
                  {
                    "type": "text",
                    "text": "Open a project and start your first conversation.",
                    "style": "body"
                  },
                  {
                    "type": "row",
                    "align": "center",
                    "gap": 8,
                    "children": [
                      {
                        "type": "button",
                        "label": "Back",
                        "id": "welcome-back",
                        "style": "secondary",
                        "icon": "arrow_back",
                        "demo": true,
                        "action": {
                          "client": [
                            {
                              "op": "setState",
                              "id": "welcomeStep",
                              "value": 1
                            }
                          ]
                        }
                      },
                      {
                        "type": "spacer"
                      },
                      {
                        "type": "button",
                        "label": "Finish",
                        "id": "welcome-finish",
                        "style": "primary",
                        "icon": "arrow_forward",
                        "demo": true,
                        "action": {
                          "client": [
                            {
                              "op": "navigate",
                              "screen": "chat:new"
                            }
                          ]
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  },
  "connect": {
    "type": "screen",
    "title": "Connect",
    "body": {
      "type": "shell",
      "id": "connect-shell",
      "breakpoint": 768,
      "topbar": {
        "type": "row",
        "id": "connect-topbar",
        "align": "center",
        "children": [
          {
            "type": "text",
            "text": "Jhin",
            "style": "h3",
            "bold": true
          },
          {
            "type": "text",
            "text": "Connect",
            "style": "body",
            "bold": true
          },
          {
            "type": "spacer"
          },
          {
            "type": "nav",
            "kind": "tabs",
            "items": [
              {
                "label": "Sessions",
                "screen": "sessions"
              },
              {
                "label": "Settings",
                "screen": "settings"
              },
              {
                "label": "Plugins",
                "screen": "plugins"
              }
            ]
          }
        ]
      },
      "topbarCompact": {
        "type": "row",
        "id": "connect-topbar-compact",
        "align": "center",
        "children": [
          {
            "type": "text",
            "text": "Jhin",
            "style": "h3",
            "bold": true
          },
          {
            "type": "text",
            "text": "Connect",
            "style": "body"
          },
          {
            "type": "spacer"
          }
        ]
      },
      "pageHeader": {
        "type": "row",
        "id": "connect-page-header",
        "align": "center",
        "gap": 8,
        "children": [
          {
            "type": "text",
            "text": "Connect",
            "style": "h3"
          },
          {
            "type": "spacer"
          },
          {
            "type": "text",
            "text": "Browser authorization",
            "style": "caption"
          }
        ]
      },
      "body": {
        "type": "container",
        "id": "connect-body",
        "direction": "column",
        "gap": 16,
        "padding": 16,
        "children": [
          {
            "type": "card",
            "id": "connect-card",
            "title": "Connect a device",
            "children": [
              {
                "type": "text",
                "text": "Connect your terminal",
                "style": "h3"
              },
              {
                "type": "text",
                "text": "Run the connect command on the machine you want to link, then paste the connection code below.",
                "style": "body"
              },
              {
                "type": "code_block",
                "code": "npx jhin connect",
                "language": "shell",
                "copyable": true
              },
              {
                "type": "input",
                "id": "connectionCode",
                "label": "Connection code",
                "placeholder": "XXXX-XXXX",
                "demo": true
              },
              {
                "type": "row",
                "align": "center",
                "gap": 8,
                "children": [
                  {
                    "type": "button",
                    "label": "Open docs",
                    "id": "connect-docs",
                    "style": "text",
                    "icon": "open_in_new",
                    "demo": true,
                    "action": {
                      "op": "openUrl",
                      "value": "https://example.invalid/docs/connect"
                    }
                  },
                  {
                    "type": "spacer"
                  },
                  {
                    "type": "button",
                    "label": "Connect",
                    "id": "connect-submit",
                    "style": "primary",
                    "icon": "link",
                    "demo": true,
                    "action": {
                      "client": [
                        {
                          "op": "toast",
                          "text": "Preview only — no device is connected in this build"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  },
  "project": {
