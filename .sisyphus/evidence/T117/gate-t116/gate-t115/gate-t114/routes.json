                      "type": "button",
                      "label": "Run",
                      "style": "secondary",
                      "icon": "play_arrow",
                      "demo": true,
                      "action": {
                        "client": [
                          {
                            "op": "toast",
                            "text": "Preview only — scripts are not run in this build"
                          }
                        ]
                      }
                    },
