{
  "type": "screen",
  "title": "degrade",
  "body": {
    "type": "container",
    "direction": "column",
    "gap": 12,
    "padding": 16,
    "children": [
      {
        "type": "badge",
        "id": "runStatus",
        "label": "Limited",
        "color": "$color.error"
      },
      {
        "type": "expanded",
        "child": {
          "type": "list",
          "id": "messages",
          "empty": "No messages yet.",
          "items": [
            {
              "type": "banner",
              "id": "ev-3",
              "content": {
                "type": "text",
                "text": "boom",
                "style": "body",
                "color": "$color.error"
              }
            },
            {
              "type": "card",
              "id": "ev-1",
              "color": "$color.accentMuted",
              "align": "centerRight",
              "borderRadius": "$radius.md",
              "padding": 12,
              "maxWidth": 560,
              "children": [
                {
                  "type": "text",
                  "text": "hello",
                  "style": "body"
                }
              ]
            },
            {
              "type": "card",
              "id": "ev-2",
              "title": "bash",
              "children": [
                {
                  "type": "text",
                  "text": "raw output",
                  "style": "body"
                }
              ]
            }
          ]
        }
      },
      {
        "type": "stream_view",
        "id": "stream",
        "topic": "/ui/stream/session/4ad230b7-ef24-4c8d-ace5-ccf32f96c7c7?fromSeq=3",
        "mode": "append",
        "itemLimit": 200,
        "autoScroll": true
      },
      {
        "type": "container",
        "id": "composer",
        "direction": "row",
        "gap": 8,
        "align": "center",
        "children": [
          {
            "type": "textarea",
            "id": "messageInput",
            "label": "Message",
            "required": true,
            "errorText": "Write a message first",
            "minLines": 1,
            "maxLines": 8,
            "autofocus": true,
            "flex": 1
          },
          {
            "type": "button",
            "label": "Send",
            "style": "primary",
            "icon": "send",
            "action": {
              "path": "/ui/action/send",
              "method": "POST",
              "name": "send",
              "payload": {
                "sessionId": "4ad230b7-ef24-4c8d-ace5-ccf32f96c7c7"
              },
              "include": [
                "messageInput"
              ]
            }
          },
          {
            "type": "icon_button",
            "icon": "add",
            "command": "composer.sendAndNew",
            "tooltip": "New session"
          }
        ]
      }
    ]
  }
}
