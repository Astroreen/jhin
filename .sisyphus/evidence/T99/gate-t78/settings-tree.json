            "type": "input",
            "id": "canvas",
            "label": "Canvas",
            "value": "#101018",
            "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "errorText": "Use #RRGGBB or #AARRGGBB"
          },
          {
            "type": "input",
            "id": "accent",
            "label": "Accent",
            "value": "#ff0000",
            "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "errorText": "Use #RRGGBB or #AARRGGBB"
          },
