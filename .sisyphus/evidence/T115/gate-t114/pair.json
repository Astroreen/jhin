{
  "type": "screen",
  "title": "Pair",
  "body": {
    "type": "container",
    "direction": "column",
    "gap": 12,
    "padding": 16,
    "children": [
      {
        "type": "text",
        "text": "Pair with this environment",
        "style": "h2"
      },
      {
        "type": "banner",
        "id": "enroll-error",
        "visible": false,
        "content": "Enrollment failed"
      },
      {
        "type": "card",
        "title": "Enroll this device",
        "children": [
          {
            "type": "form",
            "fields": [
              {
                "type": "input",
                "id": "code",
                "label": "Enrollment code",
                "required": true,
                "errorText": "Enrollment code is required"
              },
              {
                "type": "input",
                "id": "deviceName",
                "label": "Device name",
                "required": true,
                "errorText": "Device name is required"
              }
            ],
            "submit": {
              "label": "Enroll",
              "action": {
                "path": "/ui/action/enroll",
                "method": "POST",
                "name": "enroll",
                "include": [
                  "code",
                  "deviceName"
                ]
              }
            }
          }
        ]
      },
      {
        "type": "text",
        "text": "Ask your administrator for an enrollment code.",
        "style": "caption"
      }
    ]
  }
}
