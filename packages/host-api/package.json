{
  "name": "@jhin/host-api",
  "version": "0.0.0",
  "private": true,
  "description": "Contracts of the capabilities a Jhin host provides to plugins (host.paths@1, …)",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepack": "tsc -p tsconfig.build.json"
  }
}
