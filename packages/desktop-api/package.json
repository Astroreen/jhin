{
  "name": "@jhin/desktop-api",
  "version": "0.0.0",
  "private": true,
  "description": "Contract between the desktop app and its client plugin: the window.jhinDesktop bridge, update state and the desktop.shell@1 capability",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./channels": {
      "types": "./src/channels.ts",
      "import": "./src/channels.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./channels": {
        "types": "./dist/channels.d.ts",
        "import": "./dist/channels.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/build.ts"
  },
  "dependencies": {
    "@jhin/sdk": "workspace:*"
  }
}
