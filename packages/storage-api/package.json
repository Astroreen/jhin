{
  "name": "@jhin/storage-api",
  "version": "0.0.0",
  "private": true,
  "description": "Contracts of the storage.kv@1 and storage.eventlog@1 capabilities, an in-memory implementation and the contract test suite",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./contract": {
      "types": "./src/contract.ts",
      "import": "./src/contract.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/build.ts"
  },
  "dependencies": {
    "@jhin/sdk": "workspace:*"
  }
}
