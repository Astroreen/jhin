{
  "name": "@jhin/qr-code",
  "version": "0.0.0",
  "private": true,
  "description": "QR code encoder (Project Nayuki's, through T3 Code) and its terminal rendering",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/build.ts"
  }
}
