{
  "name": "@jhin/rpc",
  "version": "0.0.0",
  "private": true,
  "description": "Jhin's JSON-RPC 2.0 protocol over any message channel: server sessions, a reconnecting client, peers",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@jhin/sdk": "workspace:*",
    "@jhin/storage-api": "workspace:*"
  },
  "devDependencies": {
    "@jhin/kernel": "workspace:*"
  }
}
