{
  "name": "@jhin/health-api",
  "version": "0.0.0",
  "private": true,
  "description": "Contract of health: the health stream, warnings, ideas, sensors config and their fold",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/build.ts"
  },
  "dependencies": {
    "@jhin/sdk": "workspace:*"
  }
}
