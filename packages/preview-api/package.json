{
  "name": "@jhin/preview-api",
  "version": "0.0.0",
  "private": true,
  "description": "Contracts of preview.browser@1, preview.html@1 and device.hosts@1: the node's browser tabs, rendered HTML pages and devices",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/build.ts"
  },
  "dependencies": {
    "@jhin/sdk": "workspace:*"
  }
}
