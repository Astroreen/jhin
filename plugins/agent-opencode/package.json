{
  "name": "@jhin/plugin-agent-opencode",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCode as an agent runtime, through the HTTP API of an OpenCode 2 server",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "jhin": {
      "entry": "dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/build.ts && node ../../scripts/pack.ts guard"
  },
  "dependencies": {
    "@jhin/agent-api": "workspace:*",
    "@jhin/sdk": "workspace:*",
    "@jhin/storage-api": "workspace:*"
  },
  "devDependencies": {
    "@jhin/plugin-threads": "workspace:*",
    "@jhin/testing": "workspace:*",
    "@types/node": "catalog:"
  },
  "jhin": {
    "id": "jhin.agent-opencode",
    "version": "0.1.0",
    "apiVersion": 1,
    "name": "OpenCode",
    "description": "Runs turns with OpenCode 2 through its server: models, approvals, questions, plans and a session per thread",
    "side": "server",
    "requires": {
      "agent.registry": "^1.1",
      "storage.eventlog": "^1",
      "storage.kv": "^1"
    },
    "entry": "src/index.ts"
  }
}
