{
  "name": "@jhin/plugin-scheduler",
  "version": "0.1.0",
  "private": true,
  "description": "Scheduled tasks: prompts a node runs on an interval, at a time of day or when a webhook is called",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "jhin": {
      "entry": "dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/build.ts && node ../../scripts/pack.ts guard"
  },
  "dependencies": {
    "@jhin/agent-api": "workspace:*",
    "@jhin/http-api": "workspace:*",
    "@jhin/rpc": "workspace:*",
    "@jhin/scheduler-api": "workspace:*",
    "@jhin/sdk": "workspace:*",
    "@jhin/storage-api": "workspace:*"
  },
  "devDependencies": {
    "@jhin/plugin-agent-fake": "workspace:*",
    "@jhin/plugin-http": "workspace:*",
    "@jhin/plugin-threads": "workspace:*",
    "@jhin/testing": "workspace:*",
    "@types/node": "catalog:"
  },
  "jhin": {
    "id": "jhin.scheduler",
    "version": "0.1.0",
    "apiVersion": 1,
    "name": "Scheduler",
    "description": "Scheduled tasks: a prompt sent to a thread, or to a new thread each time, on an interval, at a time of day or when its webhook is called (T3 Code's scheduled tasks)",
    "side": "server",
    "provides": {
      "scheduler.tasks": "1.0.0"
    },
    "requires": {
      "agent.registry": "^1",
      "storage.kv": "^1",
      "storage.eventlog": "^1"
    },
    "optional": {
      "http.server": "^1",
      "rpc.streams": "^1.1"
    },
    "entry": "src/index.ts"
  }
}
