{
  "name": "@jhin/plugin-missions",
  "version": "0.1.0",
  "private": true,
  "description": "Missions and slices of a node's projects, stored as events",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "jhin": {
      "entry": "dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/build.ts && node ../../scripts/pack.ts guard"
  },
  "dependencies": {
    "@jhin/host-api": "workspace:*",
    "@jhin/missions-api": "workspace:*",
    "@jhin/rpc": "workspace:*",
    "@jhin/sdk": "workspace:*",
    "@jhin/storage-api": "workspace:*"
  },
  "devDependencies": {
    "@jhin/testing": "workspace:*",
    "@types/node": "catalog:"
  },
  "jhin": {
    "id": "jhin.missions",
    "version": "0.1.0",
    "apiVersion": 1,
    "name": "Missions",
    "description": "A project's intent, its missions and their slices, as events of the missions stream; missions.* and slices.* commands",
    "side": "server",
    "requires": {
      "storage.eventlog": "^1"
    },
    "optional": {
      "host.identity": "^1",
      "rpc.streams": "^1.1"
    },
    "entry": "src/index.ts"
  }
}
