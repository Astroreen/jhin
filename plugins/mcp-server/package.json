{
  "name": "@jhin/plugin-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Every command of the node as an MCP tool over Streamable HTTP",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "jhin": {
      "entry": "dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/build.ts && node ../../scripts/pack.ts guard"
  },
  "dependencies": {
    "@jhin/auth-api": "workspace:*",
    "@jhin/host-api": "workspace:*",
    "@jhin/http-api": "workspace:*",
    "@jhin/mcp-api": "workspace:*",
    "@jhin/mcp-bridge": "workspace:*",
    "@jhin/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:"
  },
  "devDependencies": {
    "@jhin/rpc": "workspace:*",
    "@jhin/storage-api": "workspace:*",
    "@jhin/testing": "workspace:*",
    "@types/node": "catalog:"
  },
  "jhin": {
    "id": "jhin.mcp-server",
    "version": "0.1.0",
    "apiVersion": 1,
    "name": "MCP server",
    "description": "Agents inside and outside Jhin use this node's commands as MCP tools at /mcp",
    "side": "server",
    "provides": {
      "mcp.server": "1.0.0"
    },
    "requires": {
      "http.server": "^1.2",
      "auth.verifier": "^1"
    },
    "optional": {
      "host.trace": "^1"
    },
    "entry": "src/index.ts"
  }
}
