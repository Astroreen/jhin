{
  "name": "@jhin/plugin-terminal",
  "version": "0.1.0",
  "private": true,
  "description": "Terminals on the node: PTY sessions in a thread's working directory, streamed to clients",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "jhin": {
      "entry": "dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/build.ts && node ../../scripts/pack.ts guard"
  },
  "dependencies": {
    "@jhin/agent-api": "workspace:*",
    "@jhin/rpc": "workspace:*",
    "@jhin/sdk": "workspace:*",
    "@jhin/storage-api": "workspace:*",
    "@jhin/terminal-api": "workspace:*",
    "node-pty": "catalog:"
  },
  "devDependencies": {
    "@jhin/testing": "workspace:*",
    "@types/node": "catalog:"
  },
  "jhin": {
    "id": "jhin.terminal",
    "version": "0.1.0",
    "apiVersion": 1,
    "name": "Terminal",
    "description": "PTY sessions per thread in its project's folder, their output streamed to clients (T3 Code's terminal)",
    "side": "server",
    "provides": {
      "terminal.sessions": "1.1.0"
    },
    "optional": {
      "rpc.streams": "^1",
      "storage.eventlog": "^1"
    },
    "entry": "src/index.ts"
  }
}
