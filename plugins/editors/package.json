{
  "name": "@jhin/plugin-editors",
  "version": "0.1.0",
  "private": true,
  "description": "Opening a project's files in the editors installed on a node",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "jhin": {
      "entry": "dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/build.ts && node ../../scripts/pack.ts guard"
  },
  "dependencies": {
    "@jhin/host-api": "workspace:*",
    "@jhin/sdk": "workspace:*"
  },
  "devDependencies": {
    "@jhin/testing": "workspace:*",
    "@types/node": "catalog:"
  },
  "jhin": {
    "id": "jhin.editors",
    "version": "0.1.0",
    "apiVersion": 1,
    "name": "Editors",
    "description": "Finds the editors installed on the node (VS Code, Cursor, Zed, the JetBrains IDEs, …) and opens a project's file in one",
    "side": "server",
    "provides": {
      "host.editors": "1.0.0"
    },
    "entry": "src/index.ts"
  }
}
