{
  "name": "@jhin/plugin-threads",
  "version": "0.1.0",
  "private": true,
  "description": "Projects, threads and turns, stored as events",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jhin/agent-api": "workspace:*",
    "@jhin/host-api": "workspace:*",
    "@jhin/sdk": "workspace:*",
    "@jhin/storage-api": "workspace:*"
  },
  "devDependencies": {
    "@jhin/rpc": "workspace:*",
    "@jhin/testing": "workspace:*",
    "@types/node": "catalog:"
  },
  "jhin": {
    "id": "jhin.threads",
    "version": "0.1.0",
    "apiVersion": 1,
    "name": "Threads",
    "description": "Projects, threads and turns; runs turns on the agent runtime and records them as events",
    "side": "server",
    "requires": {
      "storage.kv": "^1",
      "storage.eventlog": "^1",
      "host.paths": "^1"
    },
    "optional": {
      "agent.runtime": "^1"
    },
    "entry": "src/index.ts"
  }
}
