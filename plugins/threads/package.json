{
  "name": "@jhin/plugin-threads",
  "version": "0.1.0",
  "private": true,
  "description": "Projects, threads and turns, stored as events",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "jhin": {
      "entry": "dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/build.ts && node ../../scripts/pack.ts guard"
  },
  "dependencies": {
    "@jhin/agent-api": "workspace:*",
    "@jhin/host-api": "workspace:*",
    "@jhin/rpc": "workspace:*",
    "@jhin/sdk": "workspace:*",
    "@jhin/storage-api": "workspace:*"
  },
  "devDependencies": {
    "@jhin/testing": "workspace:*",
    "@types/node": "catalog:"
  },
  "jhin": {
    "id": "jhin.threads",
    "version": "0.1.0",
    "apiVersion": 1,
    "name": "Threads",
    "description": "Projects, threads and turns; runs turns on the node's agent runtimes and records them as events",
    "side": "server",
    "provides": {
      "agent.registry": "1.0.0"
    },
    "requires": {
      "storage.kv": "^1",
      "storage.eventlog": "^1.1",
      "host.paths": "^1"
    },
    "optional": {
      "agent.runtime": "^1",
      "rpc.streams": "^1.1"
    },
    "entry": "src/index.ts"
  }
}
