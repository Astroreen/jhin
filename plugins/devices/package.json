{
  "name": "@jhin/plugin-devices",
  "version": "0.1.0",
  "private": true,
  "description": "The node's iOS Simulators and Android Emulators for agents and the Device panel",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "jhin": {
      "entry": "dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/build.ts && node ../../scripts/pack.ts guard"
  },
  "dependencies": {
    "@jhin/agent-api": "workspace:*",
    "@jhin/preview-api": "workspace:*",
    "@jhin/rpc": "workspace:*",
    "@jhin/sdk": "workspace:*",
    "@jhin/storage-api": "workspace:*"
  },
  "devDependencies": {
    "@jhin/testing": "workspace:*",
    "@types/node": "catalog:"
  },
  "jhin": {
    "id": "jhin.devices",
    "version": "0.1.0",
    "apiVersion": 1,
    "name": "Devices",
    "description": "iOS Simulators and Android Emulators of the node: device.list, device.open, device.screenshot, device.close (T3 Code's device tools)",
    "side": "server",
    "provides": {
      "device.hosts": "1.0.0"
    },
    "optional": {
      "rpc.streams": "^1",
      "storage.eventlog": "^1"
    },
    "entry": "src/index.ts"
  }
}
