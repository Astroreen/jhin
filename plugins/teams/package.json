{
  "name": "@jhin/plugin-teams",
  "version": "0.1.0",
  "private": true,
  "description": "Teams of agents with a lead and a culture, and team bundles",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "jhin": {
      "entry": "dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/build.ts && node ../../scripts/pack.ts guard"
  },
  "dependencies": {
    "@jhin/agent-api": "workspace:*",
    "@jhin/host-api": "workspace:*",
    "@jhin/rpc": "workspace:*",
    "@jhin/sdk": "workspace:*",
    "@jhin/storage-api": "workspace:*"
  },
  "devDependencies": {
    "@jhin/plugin-agent-fake": "workspace:*",
    "@jhin/plugin-agents": "workspace:*",
    "@jhin/plugin-threads": "workspace:*",
    "@jhin/testing": "workspace:*",
    "@types/node": "catalog:"
  },
  "jhin": {
    "id": "jhin.teams",
    "version": "0.1.0",
    "apiVersion": 1,
    "name": "Teams",
    "description": "Teams of agents with a lead and a culture, put up across the mesh; team bundles (docs/plans/agents.md, A5)",
    "side": "server",
    "entry": "src/index.ts",
    "provides": {
      "teams.bundles": "1.0.0"
    },
    "requires": {
      "host.identity": "^1",
      "storage.kv": "^1",
      "storage.eventlog": "^1"
    },
    "optional": {
      "rpc.streams": "^1.1"
    }
  }
}
