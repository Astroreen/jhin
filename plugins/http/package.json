{
  "name": "@jhin/plugin-http",
  "version": "0.1.0",
  "private": true,
  "description": "The node's HTTP listener (http.server@1)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jhin/http-api": "workspace:*",
    "@jhin/sdk": "workspace:*"
  },
  "devDependencies": {
    "@jhin/testing": "workspace:*",
    "@types/node": "catalog:"
  },
  "jhin": {
    "id": "jhin.http",
    "version": "0.1.0",
    "apiVersion": 1,
    "name": "HTTP server",
    "description": "One HTTP listener per node; plugins add routes and upgrade handlers",
    "side": "server",
    "provides": {
      "http.server": "1.1.0"
    },
    "entry": "src/index.ts"
  }
}
