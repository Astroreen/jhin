{
  "name": "@jhin/plugin-agent-claude",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code as an agent runtime, through the Claude Agent SDK",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "jhin": {
      "entry": "dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/build.ts && node ../../scripts/pack.ts guard"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@jhin/agent-api": "workspace:*",
    "@jhin/mcp-api": "workspace:*",
    "@jhin/sdk": "workspace:*",
    "@jhin/storage-api": "workspace:*"
  },
  "devDependencies": {
    "@jhin/plugin-threads": "workspace:*",
    "@jhin/testing": "workspace:*",
    "@types/node": "catalog:"
  },
  "jhin": {
    "id": "jhin.agent-claude",
    "version": "0.1.0",
    "apiVersion": 1,
    "name": "Claude Code",
    "description": "Runs turns with Claude Code (the Claude Agent SDK): tools, approvals, questions, plans and a session per thread, kept running between turns or resumed",
    "side": "server",
    "requires": {
      "agent.registry": "^1.3",
      "storage.eventlog": "^1",
      "storage.kv": "^1"
    },
    "optional": {
      "mcp.server": "^1"
    },
    "entry": "src/index.ts"
  }
}
