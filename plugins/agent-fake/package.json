{
  "name": "@jhin/plugin-agent-fake",
  "version": "0.1.0",
  "private": true,
  "description": "A deterministic agent runtime for tests and demos",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "jhin": {
      "entry": "dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepack": "tsc -p tsconfig.build.json && node ../../scripts/pack-manifest.ts prepack",
    "postpack": "node ../../scripts/pack-manifest.ts postpack"
  },
  "dependencies": {
    "@jhin/agent-api": "workspace:*",
    "@jhin/sdk": "workspace:*"
  },
  "jhin": {
    "id": "jhin.agent-fake",
    "version": "0.1.0",
    "apiVersion": 1,
    "name": "Fake agent",
    "description": "Answers \"Echo: <message>\" word by word; /hold waits for an interrupt, /fail fails",
    "side": "server",
    "provides": {
      "agent.runtime": "1.0.0"
    },
    "entry": "src/index.ts"
  }
}
