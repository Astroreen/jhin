{
  "name": "@jhin/plugin-auth-token",
  "version": "0.1.0",
  "private": true,
  "description": "Static bearer token authentication (auth.verifier@1)",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "jhin": {
      "entry": "dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/build.ts && node ../../scripts/pack.ts guard"
  },
  "dependencies": {
    "@jhin/auth-api": "workspace:*",
    "@jhin/host-api": "workspace:*",
    "@jhin/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  },
  "jhin": {
    "id": "jhin.auth-token",
    "version": "0.1.0",
    "apiVersion": 1,
    "name": "Token auth",
    "description": "One owner token, generated on first start; every client presents it",
    "side": "server",
    "provides": {
      "auth.verifier": "1.1.0"
    },
    "requires": {
      "host.paths": "^1"
    },
    "entry": "src/index.ts"
  }
}
