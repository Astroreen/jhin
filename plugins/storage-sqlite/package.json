{
  "name": "@jhin/plugin-storage-sqlite",
  "version": "0.1.0",
  "private": true,
  "description": "storage.kv@1 and storage.eventlog@1 on node:sqlite",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "jhin": {
      "entry": "dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepack": "tsc -p tsconfig.build.json && node ../../scripts/pack-manifest.ts prepack",
    "postpack": "node ../../scripts/pack-manifest.ts postpack"
  },
  "dependencies": {
    "@jhin/host-api": "workspace:*",
    "@jhin/sdk": "workspace:*",
    "@jhin/storage-api": "workspace:*"
  },
  "devDependencies": {
    "@jhin/testing": "workspace:*",
    "@types/node": "catalog:"
  },
  "jhin": {
    "id": "jhin.storage-sqlite",
    "version": "0.1.0",
    "apiVersion": 1,
    "name": "SQLite storage",
    "description": "Key-value store and append-only event log in one SQLite file",
    "side": "server",
    "provides": {
      "storage.kv": "1.0.0",
      "storage.eventlog": "1.0.0"
    },
    "requires": {
      "host.paths": "^1"
    },
    "entry": "src/index.ts"
  }
}
