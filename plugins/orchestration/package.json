{
  "name": "@jhin/plugin-orchestration",
  "version": "0.1.0",
  "private": true,
  "description": "Delegated tasks, thread launches and workflows that run several agents",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "jhin": {
      "entry": "dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/build.ts && node ../../scripts/pack.ts guard"
  },
  "dependencies": {
    "@jhin/agent-api": "workspace:*",
    "@jhin/sdk": "workspace:*",
    "@jhin/storage-api": "workspace:*"
  },
  "devDependencies": {
    "@jhin/rpc": "workspace:*",
    "@jhin/testing": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "@types/node": "catalog:"
  },
  "jhin": {
    "id": "jhin.orchestration",
    "version": "0.1.0",
    "apiVersion": 1,
    "name": "Orchestration",
    "description": "Delegates tasks to child threads, launches threads in a chosen workspace and runs workflow scripts of several agents",
    "side": "server",
    "requires": {
      "agent.registry": "^1",
      "storage.kv": "^1",
      "storage.eventlog": "^1"
    },
    "entry": "src/index.ts"
  }
}
