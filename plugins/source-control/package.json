{
  "name": "@jhin/plugin-source-control",
  "version": "0.1.0",
  "private": true,
  "description": "Git status, diffs, branches and pull requests of a node's projects",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "jhin": {
      "entry": "dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/build.ts && node ../../scripts/pack.ts guard"
  },
  "dependencies": {
    "@jhin/agent-api": "workspace:*",
    "@jhin/rpc": "workspace:*",
    "@jhin/sdk": "workspace:*",
    "@jhin/source-control-api": "workspace:*",
    "@jhin/storage-api": "workspace:*"
  },
  "devDependencies": {
    "@jhin/plugin-agent-fake": "workspace:*",
    "@jhin/plugin-threads": "workspace:*",
    "@jhin/testing": "workspace:*",
    "@types/node": "catalog:"
  },
  "jhin": {
    "id": "jhin.source-control",
    "version": "0.1.0",
    "apiVersion": 1,
    "name": "Source control",
    "description": "Git status, diffs, branches and checkouts of the node's projects, each thread's branch, and pull requests through the GitHub CLI",
    "side": "server",
    "provides": {
      "source-control.git": "1.0.0"
    },
    "requires": {
      "storage.kv": "^1",
      "storage.eventlog": "^1"
    },
    "optional": {
      "rpc.streams": "^1.1"
    },
    "entry": "src/index.ts"
  }
}
