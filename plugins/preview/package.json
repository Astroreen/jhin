{
  "name": "@jhin/plugin-preview",
  "version": "0.1.0",
  "private": true,
  "description": "The node's browser: tabs per thread that the user and agents drive together, streamed to clients",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "jhin": {
      "entry": "dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/build.ts && node ../../scripts/pack.ts guard"
  },
  "dependencies": {
    "@jhin/agent-api": "workspace:*",
    "@jhin/host-api": "workspace:*",
    "@jhin/preview-api": "workspace:*",
    "@jhin/rpc": "workspace:*",
    "@jhin/sdk": "workspace:*",
    "@jhin/storage-api": "workspace:*",
    "@jhin/terminal-api": "workspace:*",
    "playwright-core": "catalog:",
    "yauzl": "catalog:"
  },
  "devDependencies": {
    "@jhin/testing": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "@types/yauzl": "catalog:",
    "ws": "catalog:"
  },
  "jhin": {
    "id": "jhin.preview",
    "version": "0.1.0",
    "apiVersion": 1,
    "name": "Browser preview",
    "description": "A headless browser on the node with tabs per thread, driven by agents and the user together (T3 Code's server browser)",
    "side": "server",
    "provides": {
      "preview.browser": "1.0.0"
    },
    "optional": {
      "host.paths": "^1",
      "rpc.streams": "^1",
      "storage.eventlog": "^1",
      "terminal.sessions": "^1.3"
    },
    "entry": "src/index.ts"
  }
}
