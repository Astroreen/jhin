{
  "name": "@jhin/plugin-secrets",
  "version": "0.1.0",
  "private": true,
  "description": "The node's secrets apart from its config files: an encrypted store with its key in the OS keychain, private secret requests in a thread and one-use secretRefs",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "jhin": {
      "entry": "dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/build.ts && node ../../scripts/pack.ts guard"
  },
  "dependencies": {
    "@jhin/agent-api": "workspace:*",
    "@jhin/host-api": "workspace:*",
    "@jhin/sdk": "workspace:*",
    "@jhin/secrets-api": "workspace:*",
    "@jhin/storage-api": "workspace:*"
  },
  "devDependencies": {
    "@jhin/mcp-api": "workspace:*",
    "@jhin/plugin-agent-fake": "workspace:*",
    "@jhin/plugin-threads": "workspace:*",
    "@jhin/rpc": "workspace:*",
    "@jhin/testing": "workspace:*",
    "@types/node": "catalog:"
  },
  "jhin": {
    "id": "jhin.secrets",
    "version": "0.1.0",
    "apiVersion": 1,
    "name": "Secrets",
    "description": "The node's secrets apart from its config files, sealed with a key from the OS keychain, and private secret requests in a thread (T3 Code's secret store and request_secret)",
    "side": "server",
    "provides": {
      "secrets.store": "1.0.0"
    },
    "requires": {
      "host.paths": "^1",
      "host.identity": "^1"
    },
    "entry": "src/index.ts",
    "optional": {
      "agent.registry": "^1",
      "storage.eventlog": "^1",
      "storage.kv": "^1"
    }
  }
}
