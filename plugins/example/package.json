{
  "name": "@jhin/plugin-example",
  "version": "0.1.0",
  "private": true,
  "description": "The copy-paste template for Jhin plugins",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "jhin": {
      "entry": "dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/build.ts && node ../../scripts/pack.ts guard"
  },
  "dependencies": {
    "@jhin/sdk": "workspace:*"
  },
  "jhin": {
    "id": "jhin.example",
    "version": "0.1.0",
    "apiVersion": 1,
    "name": "Example",
    "description": "Greets people; demonstrates services, commands, hooks, config and state",
    "side": "server",
    "provides": {
      "example.greeter": "1.0.0"
    },
    "entry": "src/index.ts"
  }
}
