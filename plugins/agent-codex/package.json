{
  "name": "@jhin/plugin-agent-codex",
  "version": "0.1.0",
  "private": true,
  "description": "Codex as an agent runtime, through `codex app-server`",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "jhin": {
      "entry": "dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/build.ts && node ../../scripts/pack.ts guard"
  },
  "dependencies": {
    "@jhin/agent-api": "workspace:*",
    "@jhin/mcp-api": "workspace:*",
    "@jhin/sdk": "workspace:*",
    "@jhin/storage-api": "workspace:*"
  },
  "devDependencies": {
    "@jhin/plugin-threads": "workspace:*",
    "@jhin/testing": "workspace:*",
    "@types/node": "catalog:"
  },
  "jhin": {
    "id": "jhin.agent-codex",
    "version": "0.1.0",
    "apiVersion": 1,
    "name": "Codex",
    "description": "Runs turns with Codex (`codex app-server`): tools, approvals, questions, plans and a Codex thread per thread, kept running between turns and resumed",
    "side": "server",
    "requires": {
      "agent.registry": "^1",
      "storage.eventlog": "^1",
      "storage.kv": "^1"
    },
    "optional": {
      "mcp.server": "^1"
    },
    "entry": "src/index.ts"
  }
}
