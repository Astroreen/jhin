{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Kernel: Debug",
      "type": "java",
      "request": "launch",
      "mainClass": "com.astroreen.jhin.kernel.KernelMain",
      "projectName": "kernel",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "shortenCommandLine": "argfile",
      "env": {
        "PATH": "${env:HOME}/.nix-profile/bin:${env:PATH}"
      }
    },
    {
      "name": "Kernel: Attach (:5005)",
      "type": "java",
      "request": "attach",
      "hostName": "localhost",
      "port": 5005
    }
  ],
  "compounds": []
}
