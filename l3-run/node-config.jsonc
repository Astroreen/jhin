        "culture": "We work on Jhin itself, in this repository. AGENTS.md is the trailhead. Small changes, the smallest proof, one mission at a time. Ask the owner (through the lead) when a decision is the owner's.",
        "agents": {
          "lead": { "role": "Talks to the owner, plans each mission into slices and runs it with the orchestrator", "runtime": "jhin.agent-claude", "model": "claude-opus-5-5", "runtimeMode": "full-access" },
          "builder": { "role": "Builds slices in the repository and proves them", "runtime": "jhin.agent-claude", "model": "claude-sonnet-5-5", "runtimeMode": "full-access" },
          "builder2": { "role": "Builds slices in the repository and proves them, beside builder when a wave has parallel slices", "runtime": "jhin.agent-claude", "model": "claude-sonnet-5-5", "runtimeMode": "full-access" },
          "reviewer": { "role": "Reviews what the builders made before the mission takes a commit or merge step", "runtime": "jhin.agent-claude", "model": "claude-sonnet-5-5", "runtimeMode": "full-access" }
        }
      }
    }
  },
